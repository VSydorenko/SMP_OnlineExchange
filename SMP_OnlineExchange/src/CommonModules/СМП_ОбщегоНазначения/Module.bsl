		ЕстьСсылка = глЕстьСсылка(Объект.Приемник, ЭтоПеречисление);
					
		Если ЕстьСсылка 
			И НЕ ЭтоПеречисление Тогда
			
			Возврат Истина;
			
		КонецЕсли;
					
	//КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции


