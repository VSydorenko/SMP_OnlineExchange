#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	МассивСтрок = Объект.ТаблицаРезультат.НайтиСтроки(Новый Структура("Пометка, Сопоставлены", Ложь, Ложь));
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		СтрокаТЧ.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	МассивСтрок = Объект.ТаблицаРезультат.НайтиСтроки(Новый Структура("Пометка", Истина));
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		СтрокаТЧ.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьВсеДанные(Команда)
	
	Объект.ОтображатьВсеДанные = НЕ Объект.ОтображатьВсеДанные;
	УстановитьСвойстваКнопкиКомандыОтображенияДанных();
