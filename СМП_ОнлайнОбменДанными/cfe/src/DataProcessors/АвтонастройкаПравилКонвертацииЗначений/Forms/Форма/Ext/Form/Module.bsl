&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ПравилоКО", Объект.ПравилоКО);
	
	Если Объект.ПравилоКО.Пустая() Тогда
		ОбщегоНазначения.СообщитьПользователю("Обработка предназначена для открытия с формы элемента учетной записи обмена.",,,, Отказ);
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Если ОбработкаОбъект.ВыполнитьСинхронизацию() Тогда
		ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьСвойстваКнопкиКомандыОтображенияДанных();
	
КонецПроцедуры

