&НаКлиенте
Процедура УстановитьСвойстваКнопкиКомандыОтображенияДанных() 
	
	Элементы.ФормаОтображатьВсеДанные.Заголовок = ?(Объект.ОтображатьВсеДанные, "Не сопоставленные", "Все");
	//Элементы.ФормаОтображатьВсеДанные.Пометка = НЕ Объект.ОтображатьВсеДанные;
	Элементы.ТаблицаРезультат.ОтборСтрок = ?(Объект.ОтображатьВсеДанные, 
	Неопределено, 
	Новый ФиксированнаяСтруктура(Новый Структура("Сопоставлены", Ложь)));
	
