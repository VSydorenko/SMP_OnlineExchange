#Область ПрограммныйИнтерфейс

// Регистрирует получение объекта при обмене: запись по двум измерениям без предварительного чтения.
//
// Параметры:
//   УчетнаяЗаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись, по которой получен объект.
//   Ссылка - ДокументСсылка - полученный объект.
//   ИмяПравила - Строка - код правила конвертации объектов, по которому получен объект.
//
Процедура ЗарегистрироватьПолучение(УчетнаяЗаписьОбмена, Ссылка, ИмяПравила) Экспорт

	СсылкаСтрокой = ЗначениеВСтрокуВнутр(Ссылка);

	НаборЗаписей = РегистрыСведений.СМП_ПолученныеОбъекты.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УчетнаяЗаписьОбмена.Установить(УчетнаяЗаписьОбмена);
	НаборЗаписей.Отбор.Объект.Установить(СсылкаСтрокой);

	Запись = НаборЗаписей.Добавить();
	Запись.УчетнаяЗаписьОбмена = УчетнаяЗаписьОбмена;
	Запись.Объект = СсылкаСтрокой;
	Запись.ТипОбъекта = Ссылка.Метаданные().ПолноеИмя();
	Запись.ИмяПравила = ИмяПравила;
	Запись.ДатаПоследнегоПолучения = ТекущаяДатаСеанса();

	НаборЗаписей.Записать(Истина);

КонецПроцедуры // ЗарегистрироватьПолучение

// Отбирает из списка ссылок те, получение которых зарегистрировано для учетной записи.
//
// Параметры:
//   УчетнаяЗаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись обмена.
//   ТаблицаСсылок - ТаблицаЗначений - таблица с колонкой Ссылка (остальные колонки не используются).
//
// Возвращаемое значение:
//   Соответствие - ключ: Ссылка из ТаблицаСсылок, найденная в регистре; значение: Строка - ИмяПравила.
//
Функция ОтобратьПолученные(УчетнаяЗаписьОбмена, ТаблицаСсылок) Экспорт

	Результат = Новый Соответствие;
	Если ТаблицаСсылок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Таблица = ТаблицаСсылок.Скопировать(, "Ссылка");
	Таблица.Колонки.Добавить("Объект", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.Объект = ЗначениеВСтрокуВнутр(СтрокаТаблицы.Ссылка);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Объект КАК Объект
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Таблица КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ссылка КАК Ссылка,
	|	Полученные.ИмяПравила КАК ИмяПравила
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СМП_ПолученныеОбъекты КАК Полученные
	|		ПО (Полученные.УчетнаяЗаписьОбмена = &УчетнаяЗаписьОбмена)
	|			И ВТ.Объект = Полученные.Объект";
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.УстановитьПараметр("УчетнаяЗаписьОбмена", УчетнаяЗаписьОбмена);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.ИмяПравила);
	КонецЦикла;

	Возврат Результат;

КонецФункции // ОтобратьПолученные

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
