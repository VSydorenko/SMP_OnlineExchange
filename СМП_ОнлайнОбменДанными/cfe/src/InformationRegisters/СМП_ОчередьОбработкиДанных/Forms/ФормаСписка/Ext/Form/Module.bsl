
#Область ОбработчикиСобытийФормы
// Код процедур и функций
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Для Каждого ДанныеСтроки Из Строки Цикл
		ДанныеСтроки.Значение.Данные.ДанныеПредставление = ЗначениеИзСтрокиВнутр(ДанныеСтроки.Значение.Данные.Данные);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбработатьСообщение(Команда)
	
	Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда
		
		// Отбор документа по строке с ошибкой регистрации не проверен: обработка запрещена.
		Если Элементы.Список.ТекущиеДанные.Статус = ПредопределенноеЗначение("Перечисление.СМП_СтатусыОбработкиСообщений.ОшибкаРегистрации") Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Сначала повторно проверьте правила регистрации.'; uk = 'Спочатку повторно перевірте правила реєстрації.'"));
			Возврат;
		КонецЕсли;
		
		ОбработатьСообщениеНаСервере(Элементы.Список.ТекущиеДанные.УникальныйИдентификатор);
		
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПовторноПроверитьПравилаРегистрации(Команда)
	
	Идентификаторы = Новый Массив;
	Для Каждого Ключ Из Элементы.Список.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(Ключ);
		Если ДанныеСтроки <> Неопределено Тогда
			Идентификаторы.Добавить(ДанныеСтроки.УникальныйИдентификатор);
		КонецЕсли;
	КонецЦикла;
	
	Если Идентификаторы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите строки очереди со статусом ""Ошибка регистрации"".'; uk = 'Виділіть рядки черги зі статусом ""Ошибка регистрации"".'"));
		Возврат;
	КонецЕсли;
	
	Результат = ПовторноПроверитьПравилаРегистрацииНаСервере(Идентификаторы);
	
	ПоказатьПредупреждение(, СтрШаблон(
		НСтр("ru = 'Повторная проверка правил регистрации завершена.
		|Возвращено в очередь: %1
		|Не проходят отбор (удалено): %2
		|Правило не удалось применить (осталось): %3'; uk = 'Повторну перевірку правил реєстрації завершено.
		|Повернуто в чергу: %1
		|Не проходять відбір (видалено): %2
		|Правило не вдалося застосувати (залишилось): %3'"),
		Результат.Прошли, Результат.НеПрошли, Результат.ОсталисьОшибки));
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запускает процес формирования исходящих сообщений сообщения.
//
// Параметры:
//   Учетнаязаписьобмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись в рамках которой обрабатывается сообщение.
//   ИдентификаторСообщения - Строка - уникальный идентификатор сообщения.
//
&НаСервереБезКонтекста
Процедура ОбработатьСообщениеНаСервере(ИдентификаторСообщения) 
	
	// Отладка
	СМП_ОнлайнОбмен.СформироватьОтправитьИсходящиеСообщения(,, ИдентификаторСообщения,, Истина);
	
КонецПроцедуры //ОбработатьСообщениеНаСервере

// Повторно проверяет правила регистрации для выбранных строк очереди.
//
// Параметры:
//   Идентификаторы - Массив из Строка - идентификаторы строк очереди.
//
// Возвращаемое значение:
//   Структура - см. СМП_ОнлайнОбменУправлениеОчередями.ПовторноПроверитьПравилаРегистрации.
//
&НаСервереБезКонтекста
Функция ПовторноПроверитьПравилаРегистрацииНаСервере(Идентификаторы)
	
	Возврат СМП_ОнлайнОбменУправлениеОчередями.ПовторноПроверитьПравилаРегистрации(Идентификаторы);
	
КонецФункции

#КонецОбласти