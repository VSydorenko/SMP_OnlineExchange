////////////////////////////////////////////////////////////////////////////////
// СМП_ОнлайнОбменУправлениеОчередями: работа с сообщениями онлайн-обменов данными.
// 
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область ДобавлениеВОчередь

// Регистрирует объект в очереди обработки данных.
//
// Параметры:
//   УчетнаяЗаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись обмена для которой регистрируется сообщение.
//   ОбъектСсылка - ДокументССылка, СправочникСсылка - ссылка на объект, который регистрируется в очереди.
//
Процедура ДобавитьСообщениеВОчередьОбработки(УчетнаяЗаписьОбмена, ОбъектСсылка) Экспорт
	
	уидПользователяИБ = СМП_ОнлайнОбменПовтИсп.ПолучитьИдентификаторТекущегоПользователяИБ();
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи = ПолучитьМенеджерСообщения("СМП_ОчередьОбработкиДанных", ИдентификаторСообщения);
	МенеджерЗаписи.УчетнаяЗаписьОбмена = УчетнаяЗаписьОбмена;
	МенеджерЗаписи.ИдентификаторПользователяИБ = уидПользователяИБ;
	МенеджерЗаписи.Данные = ЗначениеВСтрокуВнутр(ОбъектСсылка);
	МенеджерЗаписи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	// ДЛЯ ОТЛАДКИ:
	//Возврат;
	
	СформироватьОтправитьИсходящиеСообщенияВФоне(УчетнаяЗаписьОбмена, уидПользователяИБ);
	
КонецПроцедуры //ДобавитьСообщениеВОчередьОбработки

// Регистрирует в очереди обработки данных ошибку применения правила регистрации: отбор документа
// не проверен. Строка получает статус ОшибкаРегистрации; фоновое задание отправки не запускается.
//
// Параметры:
//   УчетнаяЗаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись, правило которой не удалось применить.
//   ОбъектСсылка - ДокументСсылка - документ, для которого правило не удалось применить.
//   ТекстОшибки - Строка - причина ошибки.
//
Процедура ДобавитьОшибкуРегистрацииВОчередьОбработки(УчетнаяЗаписьОбмена, ОбъектСсылка, ТекстОшибки) Экспорт
	
	уидПользователяИБ = СМП_ОнлайнОбменПовтИсп.ПолучитьИдентификаторТекущегоПользователяИБ();
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = ПолучитьМенеджерСообщения("СМП_ОчередьОбработкиДанных", Строка(Новый УникальныйИдентификатор));
	МенеджерЗаписи.УчетнаяЗаписьОбмена = УчетнаяЗаписьОбмена;
	МенеджерЗаписи.ИдентификаторПользователяИБ = уидПользователяИБ;
	МенеджерЗаписи.Данные = ЗначениеВСтрокуВнутр(ОбъектСсылка);
	МенеджерЗаписи.Статус = Перечисления.СМП_СтатусыОбработкиСообщений.ОшибкаРегистрации;
	МенеджерЗаписи.СообщениеОбОшибке = ТекстОшибки;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Повторно проверяет правила регистрации для строк очереди обработки со статусом ОшибкаРегистрации.
// Документы, прошедшие отбор, возвращаются в очередь (статус Новое, по одной строке на пару
// "учетная запись - документ"), остальные строки удаляются. Строки, правило которых по-прежнему
// невалидно, остаются, текст ошибки обновляется. Строки других статусов игнорируются.
//
// Параметры:
//   ИдентификаторыСообщений - Массив из Строка - идентификаторы строк очереди обработки данных.
//
// Возвращаемое значение:
//   Структура - счетчики пар "учетная запись - документ":
//     * Прошли - Число - документ прошел отбор, возвращен в очередь.
//     * НеПрошли - Число - документ не проходит отбор, строки удалены.
//     * ОсталисьОшибки - Число - правило не удалось применить, строки остались.
//
Функция ПовторноПроверитьПравилаРегистрации(ИдентификаторыСообщений) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура("Прошли, НеПрошли, ОсталисьОшибки", 0, 0, 0);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Очередь.УникальныйИдентификатор КАК УникальныйИдентификатор,
	|	Очередь.УчетнаяЗаписьОбмена КАК УчетнаяЗапись,
	|	Очередь.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
	|	Очередь.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.СМП_ОчередьОбработкиДанных КАК Очередь
	|ГДЕ
	|	Очередь.УникальныйИдентификатор В (&Идентификаторы)
	|	И Очередь.Статус = ЗНАЧЕНИЕ(Перечисление.СМП_СтатусыОбработкиСообщений.ОшибкаРегистрации)");
	Запрос.УстановитьПараметр("Идентификаторы", ИдентификаторыСообщений);
	СтрокиОчереди = Запрос.Выполнить().Выгрузить();
	
	// Группы "учетная запись x тип документа"; в группе - документы и их строки очереди.
	Группы = Новый Соответствие;
	Для Каждого СтрокаОчереди Из СтрокиОчереди Цикл
		
		Попытка
			ОбъектСсылка = ЗначениеИзСтрокиВнутр(СтрокаОчереди.Данные);
			ПолноеИмяДокумента = ОбъектСсылка.Метаданные().ПолноеИмя();
		Исключение
			// Данные строки не разобрать: правило применить нельзя, строка остается как есть.
			Результат.ОсталисьОшибки = Результат.ОсталисьОшибки + 1;
			Продолжить;
		КонецПопытки;
		
		КлючГруппы = Строка(СтрокаОчереди.УчетнаяЗапись.УникальныйИдентификатор()) + "/" + ПолноеИмяДокумента;
		Группа = Группы.Получить(КлючГруппы);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("УчетнаяЗапись, ПолноеИмяДокумента, Документы", 
				СтрокаОчереди.УчетнаяЗапись, ПолноеИмяДокумента, Новый Соответствие);
			Группы.Вставить(КлючГруппы, Группа);
		КонецЕсли;
		
		СтрокиДокумента = Группа.Документы.Получить(ОбъектСсылка);
		Если СтрокиДокумента = Неопределено Тогда
			СтрокиДокумента = Новый Массив;
			Группа.Документы.Вставить(ОбъектСсылка, СтрокиДокумента);
		КонецЕсли;
		СтрокиДокумента.Добавить(СтрокаОчереди);
		
	КонецЦикла;
	
	// Пары "учетная запись x пользователь ИБ" строк, возвращенных в очередь.
	ЗапускиОтправки = Новый Соответствие;
	
	Для Каждого ЭлементГруппы Из Группы Цикл
		
		Группа = ЭлементГруппы.Значение;
		ТекстОшибки = "";
		ПрошедшиеДокументы = Новый Соответствие;
		
		// Правила нет: учетная запись больше не выгружает этот документ, документы группы не проходят.
		Правило = СМП_ОнлайнОбменПравилаРегистрации.ПравилаУчетнойЗаписи(Группа.УчетнаяЗапись, Группа.ПолноеИмяДокумента);
		Если Правило <> Неопределено Тогда
			Если Не ПустаяСтрока(Правило.ТекстОшибки) Тогда
				ТекстОшибки = Правило.ТекстОшибки;
			Иначе
				Попытка
					ПрошедшиеДокументы = ДокументыГруппыПроходящиеОтбор(Правило, Группа);
				Исключение
					ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого ЭлементДокумента Из Группа.Документы Цикл
			
			СтрокиДокумента = ЭлементДокумента.Значение;
			
			Если Не ПустаяСтрока(ТекстОшибки) Тогда
				
				Для Каждого СтрокаОчереди Из СтрокиДокумента Цикл
					ЗаписатьОшибку("", СтрокаОчереди.УникальныйИдентификатор, 
						Перечисления.СМП_СтатусыОбработкиСообщений.ОшибкаРегистрации, ТекстОшибки);
				КонецЦикла;
				Результат.ОсталисьОшибки = Результат.ОсталисьОшибки + 1;
				
			ИначеЕсли ПрошедшиеДокументы.Получить(ЭлементДокумента.Ключ) <> Неопределено Тогда
				
				// Одна строка на пару возвращается в очередь; дубликаты (накопились, пока правило
				// было сломано) удаляются.
				Для Индекс = 0 По СтрокиДокумента.ВГраница() Цикл
					СтрокаОчереди = СтрокиДокумента[Индекс];
					Если Индекс = 0 Тогда
						УстановитьСтатусНовое(СтрокаОчереди.УникальныйИдентификатор);
						КлючЗапуска = Строка(СтрокаОчереди.УчетнаяЗапись.УникальныйИдентификатор()) + "/" 
							+ СтрокаОчереди.ИдентификаторПользователяИБ;
						ЗапускиОтправки.Вставить(КлючЗапуска, 
							Новый Структура("УчетнаяЗапись, ИдентификаторПользователяИБ", 
								СтрокаОчереди.УчетнаяЗапись, СтрокаОчереди.ИдентификаторПользователяИБ));
					Иначе
						УдалитьСообщениеИзОчереди(СтрокаОчереди.УникальныйИдентификатор);
					КонецЕсли;
				КонецЦикла;
				Результат.Прошли = Результат.Прошли + 1;
				
			Иначе
				
				Для Каждого СтрокаОчереди Из СтрокиДокумента Цикл
					УдалитьСообщениеИзОчереди(СтрокаОчереди.УникальныйИдентификатор);
				КонецЦикла;
				Результат.НеПрошли = Результат.НеПрошли + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Возвращенные в очередь строки обрабатывает фоновое задание отправки.
	Для Каждого ЭлементЗапуска Из ЗапускиОтправки Цикл
		СформироватьОтправитьИсходящиеСообщенияВФоне(
			ЭлементЗапуска.Значение.УчетнаяЗапись, ЭлементЗапуска.Значение.ИдентификаторПользователяИБ);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Регистрирует объект для отправки в очереди исходящих сообщений.
//
// Параметры:
//   УчетнаяЗаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись обмена для которой регистрируется сообщение.
//   Сообщение - ДокументССылка, СправочникСсылка - ссылка на объект, который регистрируется в очереди.
//
Процедура ДобавитьСообщениеВОчередьИсходящих(уидПользователяИБ, УчетнаяЗаписьОбмена, Сообщение) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	УникальныйИдентификатор = Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи = ПолучитьМенеджерСообщения("СМП_ОчередьИсходящихСообщений", УникальныйИдентификатор);
	МенеджерЗаписи.УчетнаязаписьОбмена = УчетнаяЗаписьОбмена;
	МенеджерЗаписи.ИдентификаторПользователяИБ = уидПользователяИБ;
	МенеджерЗаписи.Данные = Сообщение;
	МенеджерЗаписи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Регистрирует полученные данные в очереди входящих сообщений.
//
// Параметры:
//   УчетнаяЗаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись обмена для которой регистрируется сообщение.
//   Сообщение - Строка - входящие данные в формате JSON.
//
// Возвращаемое значение:
//   Строка - Строковое представление уникального идентификатора сообщения.
//
Функция ДобавитьСообщениеВОчередьВходящих(УчетнаяЗаписьОбмена, Сообщение) Экспорт
	
	ИдентификаторПользователяИБ = СМП_ОнлайнОбменПовтИсп.ПолучитьИдентификаторТекущегоПользователяИБ();
	
	УстановитьПривилегированныйРежим(Истина);
	
	УникальныйИдентификатор = Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи = ПолучитьМенеджерСообщения("СМП_ОчередьВходящихСообщений", УникальныйИдентификатор);
	МенеджерЗаписи.ИдентификаторПользователяИБ = ИдентификаторПользователяИБ;
	МенеджерЗаписи.УчетнаяЗаписьОбмена = УчетнаяЗаписьОбмена;
	МенеджерЗаписи.Данные = Сообщение;
	МенеджерЗаписи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ОбработатьВходящиеСообщенияВФоне(УчетнаяЗаписьОбмена, ИдентификаторПользователяИБ);
	
	Возврат УникальныйИдентификатор;
	
КонецФункции

// .
//
// Параметры:
//   ИдентификаторСообщения - Строка - Строковое представление уникального идентификатора удаляемого сообщения.
//   Очередь - Строка - имя очереди из которой удаляется сообщение ("исход","вход", "").
//
Процедура УдалитьСообщениеИзОчереди(ИдентификаторСообщения, Очередь = "") Экспорт
	
	НЗ = НаборЗаписейПоИмениОчереди(Очередь);
	НЗ.Отбор.УникальныйИдентификатор.Установить(ИдентификаторСообщения);
	НЗ.Записать();
	
КонецПроцедуры //УдалитьСообщениеИзОчереди

#КонецОбласти

#Область ОбработкаОчередей

// Выполняет обработку сообщения в очереди исходящих.
//
// Параметры:
//   УчетнаязаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись обмена в рамках которой отправляется сообщение.
//   ИдентификаторСообщения - Строка - уникальный идентификатор сообщения в очереди исходящих.
//
Процедура ОтправитьСообщение(УчетнаязаписьОбмена, ИдентификаторСообщения) Экспорт
	
	УстановитьСтатусВОбработке(ИдентификаторСообщения, "Исход");
	Данные = ПолучитьИсходящееСообщениеПоИдентификатору(ИдентификаторСообщения);
	ДанныеСсылка = ЗначениеИзСтрокиВнутр(Данные);
	СМП_ОнлайнОбменСобытия.ОтправитьСообщение(УчетнаязаписьОбмена, ДанныеСсылка);
	УстановитьСтатусОбработано(ИдентификаторСообщения, "Исход");
	
КонецПроцедуры //ОбработатьИсходящееСообщение

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ДобавлениеВОчередь_Служебное

Функция ПолучитьМенеджерСообщения(ИмяОчереди, УникальныйИдентификатор = Неопределено, ТаймШтамп = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если УникальныйИдентификатор = Неопределено Тогда
		УникальныйИдентификатор = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Если ТаймШтамп = Неопределено Тогда
		ТаймШтамп = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений[ИмяОчереди].СоздатьМенеджерЗаписи();
	МенеджерЗаписи.УникальныйИдентификатор = УникальныйИдентификатор;
	МенеджерЗаписи.ДатаДобавления          = ТекущаяДатаСеанса();
	МенеджерЗаписи.ТаймШтамп               = ТаймШтамп;
	МенеджерЗаписи.Статус                  = Перечисления.СМП_СтатусыОбработкиСообщений.Новое;
	
	Возврат МенеджерЗаписи;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

#КонецОбласти

#Область ОбновлениеСтатусов

Функция УстановитьСтатусНовое(УникальныйИдентификатор, Очередь = "") Экспорт
	
	ОбновитьСтатусСообщения(Очередь, УникальныйИдентификатор, Перечисления.СМП_СтатусыОбработкиСообщений.Новое);
	
КонецФункции

Функция УстановитьСтатусВОбработке(УникальныйИдентификатор, Очередь = "") Экспорт
	
	ОбновитьСтатусСообщения(Очередь, УникальныйИдентификатор, Перечисления.СМП_СтатусыОбработкиСообщений.ВОбработке);
	
КонецФункции

Функция УстановитьСтатусДоставлено(УникальныйИдентификатор, Очередь = "") Экспорт
	
	ОбновитьСтатусСообщения(Очередь, УникальныйИдентификатор, Перечисления.СМП_СтатусыОбработкиСообщений.Доставлено);
	
КонецФункции

Функция УстановитьСтатусОтправлено(УникальныйИдентификатор, Очередь = "") Экспорт
	
	ОбновитьСтатусСообщения(Очередь, УникальныйИдентификатор, Перечисления.СМП_СтатусыОбработкиСообщений.Отправлено);
	
КонецФункции

