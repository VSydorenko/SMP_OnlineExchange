#Область ПрограммныйИнтерфейс

Процедура СМП_РегистрацияДокументаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ДополнительныеСвойства.Свойство("СМП_ОтключитьРегистрациюВОчереди") 
		И Источник.ДополнительныеСвойства.СМП_ОтключитьРегистрациюВОчереди = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Источник.ДополнительныеСвойства.Вставить("СМП_РежимЗаписиДокумента", РежимЗаписи);
	
КонецПроцедуры

Процедура СМП_РегистрацияДокументаПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина ИЛИ Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("СМП_РежимЗаписиДокумента") 
		И (Источник.ДополнительныеСвойства.СМП_РежимЗаписиДокумента = РежимЗаписиДокумента.Запись 
			ИЛИ Источник.ДополнительныеСвойства.СМП_РежимЗаписиДокумента = РежимЗаписиДокумента.ОтменаПроведения) Тогда
		ВыполнитьРегистрациюДокументаВОчереди(Источник, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура СМП_РегистрацияДокументаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ДополнительныеСвойства.Свойство("СМП_РежимЗаписиДокумента") 
		И Источник.ДополнительныеСвойства.СМП_РежимЗаписиДокумента = РежимЗаписиДокумента.Проведение Тогда
		ВыполнитьРегистрациюДокументаВОчереди(Источник, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПриЗаписи" справочников для механизма онлайн-обмена.
//
// Параметры:
//   Источник - СправочникОбъект - источник события.
//   Отказ - Булево - флаг отказа от выполнения обработчика.
//
Процедура СМП_СправочникПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина ИЛИ Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВыборкаУчетныхЗаписей = РегистрыСведений.СМП_ВыгруженныеСправочники.ПроверитьВыгрузкуЭлементаСправочника(Источник.Ссылка);
	Если НЕ ВыборкаУчетныхЗаписей = Неопределено Тогда
		
		Пока ВыборкаУчетныхЗаписей.Следующий() Цикл
			
			СМП_ОнлайнОбменУправлениеОчередями.ДобавитьСообщениеВОчередьОбработки(ВыборкаУчетныхЗаписей.УчетнаяЗаписьОбмена, Источник.Ссылка);
			
		КонецЦикла;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// СТАРАЯ ЛОГИКА УБРАТЬ! Выполняет отправку сообщения.
//
// Параметры:
//   УчетнаязаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись обмена для которой обрабатывается сообщение.
//   ДанныеСсылка - ДокументСсылка, СправочникСсылка - ссылочные данные для отправки
//
Процедура ОтправитьСообщение(УчетнаяЗаписьОбмена, ДанныеСсылка) Экспорт
	
	//ПакетДанных = СМП_ОнлайнОбмен.ДанныеПоСсылкеВJSON(ДанныеСсылка, УчетнаяЗаписьОбмена, Истина);
	ПакетДанных = СМП_ОнлайнОбмен.ДанныеПоСсылкеВJSON_2(ДанныеСсылка, УчетнаяЗаписьОбмена, Истина);
	НастройкиТранспорта = СМП_ОнлайнОбменПовтИсп.ПолучитьНастройкиТранспортаОбменаДанными(УчетнаяЗаписьОбмена);
	
	Если НастройкиТранспорта.ВидТранспорта = Перечисления.СМП_ВидыТранспортовОбмена.ХттпСервис Тогда
		СМП_СобытияОтправкиДанных.ОтправитьСообщениеЧерезХТТП(ПакетДанных, НастройкиТранспорта);
	ИначеЕсли НастройкиТранспорта.ВидТранспорта = Перечисления.СМП_ВидыТранспортовОбмена.Ком Тогда
		СМП_СобытияОтправкиДанных.ОтправитьСообщениеЧерезКОМ(ПакетДанных, НастройкиТранспорта);
	ИначеЕсли НастройкиТранспорта.ВидТранспорта = Перечисления.СМП_ВидыТранспортовОбмена.Файл Тогда
		СМП_СобытияОтправкиДанных.ОтправитьСообщениеЧерезФайл(ПакетДанных, НастройкиТранспорта);
	Иначе
		
	КонецЕсли;
	
КонецПроцедуры //ОтправитьСообщение

// .
//
// Параметры:
//   НастройкиТранспорта - Структура - см. СМП_ОнлайнОбмен.ПолучитьНастройкиТранспортаОбменаДанными()
//   ДанныеДляОтправки - Строка - строка с данными в формате JSON
//
// Возвращаемое значение:
//   Структура:
//    * Успешно - Булево - признак успешной отправки пакета данных
//    * ТекстОшибки - Строка - строка с описанием ошибки
//
Функция ОтправитьИсходящееСообщение(НастройкиТранспорта, ДанныеДляОтправки) Экспорт
	
	Если НастройкиТранспорта.ВидТранспорта = Перечисления.СМП_ВидыТранспортовОбмена.ХттпСервис Тогда
		Результат = СМП_СобытияОтправкиДанных.ОтправитьСообщениеЧерезХТТП(ДанныеДляОтправки, НастройкиТранспорта);
	ИначеЕсли НастройкиТранспорта.ВидТранспорта = Перечисления.СМП_ВидыТранспортовОбмена.Ком Тогда
		Результат = СМП_СобытияОтправкиДанных.ОтправитьСообщениеЧерезКОМ(ДанныеДляОтправки, НастройкиТранспорта);
	ИначеЕсли НастройкиТранспорта.ВидТранспорта = Перечисления.СМП_ВидыТранспортовОбмена.Файл Тогда
		Результат = СМП_СобытияОтправкиДанных.ОтправитьСообщениеЧерезФайл(ДанныеДляОтправки, НастройкиТранспорта);
	Иначе
		ТекстОшибки = СтрШаблон("Отсутствует функция отправки сообщения для вида транспорта ""%1""", НастройкиТранспорта.ВидТранспорта);
		Результат = Новый Структура("Успешно, ТекстОшибки", Ложь, ТекстОшибки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ОтправитьИсходящееСообщение

