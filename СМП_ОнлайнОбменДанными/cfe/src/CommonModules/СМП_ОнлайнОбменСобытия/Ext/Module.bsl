// Выполняет запись набора ссылок элементов справочников, которые были полностью сериализованы в сеасе обмена данными.
// Для запуска через фоновое задание.
//
// Параметры:
//   УчетнаяЗаписьОбмена - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись, в рамках которой выполняется обмен данными.
//   ЭлементСправочника - СправочникСсылка - ссылка на элемент выгружаемого справочника.
//
Процедура ЗарегистрироватьВыгруженныеЭлементыСправочников(УчетнаяЗаписьОбмена, ЭлементыСправочников) Экспорт
	
	РегистрыСведений.СМП_ВыгруженныеСправочники.ЗарегистрироватьВыгрузкуЭлементовСправочников(
		УчетнаяЗаписьОбмена, ЭлементыСправочников);
	
КонецПроцедуры //ЗарегистрироватьВыгруженныеЭлементыСправочников

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет проверку и регистрацию документа в очереди для всех учетных записей онлайн-обменов.
//
// Параметры:
//   Объект - ДокументОбъект - регистрируемый документ.
//   Отказ - Булево - признак возникновения ошибки во время регистрации объекта в очереди:
//    если во время регистрации объекта возникнут ошибки, то этот флаг будет установлен в значение Истина.
//
Процедура ВыполнитьРегистрациюДокументаВОчереди(Объект, Отказ) 
	
	// Получение таблицы Схем компоновок данных для существующих обменов.
	ТаблицаПРД = СМП_ОнлайнОбменПовтИсп.ПолучитьТаблицуПравилРегистрацииДокументов();
	Если ТаблицаПРД.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяДокумента = Объект.Метаданные().ПолноеИмя();
	ПравилаПоДокументу = ТаблицаПРД.Скопировать(Новый Структура("ИмяДокумента", ИмяДокумента));
	Если ПравилаПоДокументу.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Выполнение проверки по всем подходящим СКД
	// Регистрация документа в очереди к выгрузке по каждому обмену
	Для Каждого СтрокаПравило Из ПравилаПоДокументу Цикл
		
		Если УсловияОтбораУдовлетворены(Объект, СтрокаПравило) Тогда
			
			СМП_ОнлайнОбменУправлениеОчередями.ДобавитьСообщениеВОчередьОбработки(СтрокаПравило.УчетнаяЗапись, Объект.Ссылка);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //ВыполнитьРегистрациюДокументаВОчереди

// Проверяет документ перед регистрацией на предмет соответствия условиям отбора.
//
// Параметры:
//   Объект - ДокументОбъект - документ для проверки.
//   СтрокаПравило - СтрокаТаблицыЗначений - см. СМП_ОнлайнОбменПовтИсп.ИнициализироватьТаблицуПРД()
//
// Возвращаемое значение:
//   Булево - признак удовлетворения условий отбора документом.
//
Функция УсловияОтбораУдовлетворены(Объект, СтрокаПравило) 
	
	РезультатПроверки = Ложь;
	
	Если Объект.Дата <  СтрокаПравило.ДатаНачалаВыгрузкиДокументов Тогда
		Возврат РезультатПроверки;
	КонецЕсли;
	
	РезультатПроверки = ПроверитьОбъектПоУсловиямОтбора(СтрокаПравило.СхемаКД, Объект.Ссылка);
	
	Возврат РезультатПроверки;
	
КонецФункции // УсловияОтбораУдовлетворены

// Проверяет документ на предмет удовлетворения условий отбора заданных в Схеме КД.
//
// Параметры:
//   СхемаКД - СхемаКомпоновкиДанных - СКД с условиями отбора для конкретного типа документа.
//   ОбъектСсылка - ДокументСсылка - ссылка на проверяемый документ.
//
// Возвращаемое значение:
//   Булево - признак удовлетворения условий отбора схемы КД.
//
Функция ПроверитьОбъектПоУсловиямОтбора(СхемаКД, ОбъектСсылка) Экспорт

	ТаблицаРезультат = РезультатКомпоновкиОтбора(СхемаКД, ОбъектСсылка);

	Возврат ТаблицаРезультат.Количество() > 0;

КонецФункции // ПроверитьОбъектПоУсловиямОтбора

// Отбирает документы, удовлетворяющие условиям отбора схемы КД, одной компоновкой.
//
// Схема строится под одну ссылку (условие "ОБ.Ссылка = &ПараметрСсылка",
// см. Справочники.СМП_УчетныеЗаписиОбменов.ПолучитьСКД). На время компоновки условие
// заменяется на "В (&ПараметрСсылка)", параметр получает список ссылок; затем схема восстанавливается.
// Если условия в таком виде нет (запрос схемы правили вручную) - документы проверяются по одному.
//
// Параметры:
//   СхемаКД - СхемаКомпоновкиДанных - СКД с условиями отбора для конкретного типа документа.
//   Ссылки - Массив из ДокументСсылка - проверяемые документы этого типа.
//
// Возвращаемое значение:
//   Массив из ДокументСсылка - документы из Ссылки, удовлетворяющие условиям отбора.
//
Функция ОтобратьОбъектыПоУсловиямОтбора(СхемаКД, Ссылки) Экспорт

	Результат = Новый Массив;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	УсловиеОднойСсылки = "ОБ.Ссылка = &ПараметрСсылка";
	НаборДанных = Неопределено;
	Для Каждого НаборСхемы Из СхемаКД.НаборыДанных Цикл
		Если ТипЗнч(НаборСхемы) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных")
			И СтрНайти(НаборСхемы.Запрос, УсловиеОднойСсылки) > 0 Тогда
			НаборДанных = НаборСхемы;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ПараметрСхемы = СхемаКД.Параметры.Найти("ПараметрСсылка");

	Если НаборДанных = Неопределено Или ПараметрСхемы = Неопределено Тогда
		Возврат ОтобратьОбъектыПоОдному(СхемаКД, Ссылки);
	КонецЕсли;

	ИсходныйЗапрос = НаборДанных.Запрос;
	ИсходныйДоступенСписокЗначений = ПараметрСхемы.ДоступенСписокЗначений;
	НаборДанных.Запрос = СтрЗаменить(ИсходныйЗапрос, УсловиеОднойСсылки, "ОБ.Ссылка В (&ПараметрСсылка)");
	ПараметрСхемы.ДоступенСписокЗначений = Истина;

	СписокСсылок = Новый СписокЗначений;
	СписокСсылок.ЗагрузитьЗначения(Ссылки);
	Попытка
		ТаблицаРезультат = РезультатКомпоновкиОтбора(СхемаКД, СписокСсылок, Истина);
	Исключение
		НаборДанных.Запрос = ИсходныйЗапрос;
		ПараметрСхемы.ДоступенСписокЗначений = ИсходныйДоступенСписокЗначений;
		ВызватьИсключение;
	КонецПопытки;
	НаборДанных.Запрос = ИсходныйЗапрос;
	ПараметрСхемы.ДоступенСписокЗначений = ИсходныйДоступенСписокЗначений;

	// Структуру настроек правили вручную, и Ссылка в результат не попала.
	Если ТаблицаРезультат.Колонки.Найти("Ссылка") = Неопределено Тогда
		Возврат ОтобратьОбъектыПоОдному(СхемаКД, Ссылки);
	КонецЕсли;

	// Отбор по табличной части может дать несколько строк на документ.
	Отобранные = Новый Соответствие;
	Для Каждого СтрокаРезультата Из ТаблицаРезультат Цикл
		Если Отобранные.Получить(СтрокаРезультата.Ссылка) = Неопределено Тогда
			Отобранные.Вставить(СтрокаРезультата.Ссылка, Истина);
			Результат.Добавить(СтрокаРезультата.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции // ОтобратьОбъектыПоУсловиямОтбора

Функция ОтобратьОбъектыПоОдному(СхемаКД, Ссылки)

	Результат = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		Если ПроверитьОбъектПоУсловиямОтбора(СхемаКД, Ссылка) Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции // ОтобратьОбъектыПоОдному

// Выполняет компоновку схемы отбора с заданным значением параметра ПараметрСсылка.
//
// Параметры:
//   СхемаКД - СхемаКомпоновкиДанных - СКД с условиями отбора.
//   ЗначениеПараметра - ДокументСсылка, СписокЗначений - значение параметра ПараметрСсылка.
//   ВыбиратьСсылку - Булево - добавить поле Ссылка в выбранные поля, если его там нет.
//
// Возвращаемое значение:
//   ТаблицаЗначений - результат компоновки.
//
Функция РезультатКомпоновкиОтбора(СхемаКД, ЗначениеПараметра, ВыбиратьСсылку = Ложь)

	НастройкиКД = СхемаКД.НастройкиПоУмолчанию;

	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКД));
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКД);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	НастройкиРезультат = КомпоновщикНастроек.ПолучитьНастройки();
	НастройкиРезультат.ПараметрыДанных.УстановитьЗначениеПараметра("ПараметрСсылка", ЗначениеПараметра);

	Если ВыбиратьСсылку Тогда
		ПолеСсылка = Новый ПолеКомпоновкиДанных("Ссылка");
		СсылкаВыбрана = Ложь;
		Для Каждого ЭлементВыбора Из НастройкиРезультат.Выбор.Элементы Цикл
			Если ТипЗнч(ЭлементВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных")
				И ЭлементВыбора.Поле = ПолеСсылка И ЭлементВыбора.Использование Тогда
				СсылкаВыбрана = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не СсылкаВыбрана Тогда
			ВыбранноеПоле = НастройкиРезультат.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВыбранноеПоле.Поле = ПолеСсылка;
			ВыбранноеПоле.Использование = Истина;
		КонецЕсли;
	КонецЕсли;

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКД, НастройкиРезультат,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТаблицаРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Ложь);

	Возврат ТаблицаРезультат;

КонецФункции // РезультатКомпоновкиОтбора

#КонецОбласти