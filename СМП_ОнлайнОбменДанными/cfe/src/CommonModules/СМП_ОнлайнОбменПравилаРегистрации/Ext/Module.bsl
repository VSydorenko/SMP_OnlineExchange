
#Область ПрограммныйИнтерфейс

// Возвращает текст набора данных схемы компоновки данных для отбора документов.
// Текст выбирает все реквизиты и табличные части документа (звездочка), поэтому не содержит
// имен реквизитов и не устаревает при изменении метаданных.
//
// Параметры:
//   ПолноеИмяДокумента - Строка - полное имя документа, например "Документ.РасходнаяНакладная".
//
// Возвращаемое значение:
//   Строка - текст запроса набора данных.
//
Функция ТекстНабораДанных(ПолноеИмяДокумента) Экспорт

	Возврат СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ %1 КАК ОБ ГДЕ ОБ.Ссылка В (&ПараметрСсылка)", ПолноеИмяДокумента);

КонецФункции

// Возвращает схему компоновки данных для отбора документов при регистрации в очереди.
//
// Параметры:
//   ПолноеИмяДокумента - Строка - полное имя документа, например "Документ.РасходнаяНакладная".
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных - схема с одним набором данных и параметром ПараметрСсылка.
//
Функция СхемаОтбораДокумента(ПолноеИмяДокумента) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	СКД = Новый СхемаКомпоновкиДанных;

	ИсточникДанных = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "local";

	НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = ПолноеИмяДокумента;
	НаборДанных.Запрос = ТекстНабораДанных(ПолноеИмяДокумента);
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;

	ПолеСсылка = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеСсылка.Заголовок = "Ссылка";
	ПолеСсылка.Использование = Истина;
	ПолеСсылка.Поле = Новый ПолеКомпоновкиДанных("Ссылка");

	ГруппировкаСКД = СКД.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСКД.Использование = Истина;

	АвтоВыбранныеПоля = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	АвтоВыбранныеПоля.Использование = Истина;

	ВыбранныеПоляПорядка = ГруппировкаСКД.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	ВыбранныеПоляПорядка.Использование = Истина;

	ПараметрСсылка = СКД.Параметры.Добавить();
	ПараметрСсылка.Имя = "ПараметрСсылка";
	ПараметрСсылка.Заголовок = " Ссылка на документ";
	ПараметрСсылка.ТипЗначения = Новый ОписаниеТипов("ДокументСсылка." + ИмяДокументаПоПолномуИмени(ПолноеИмяДокумента));
	ПараметрСсылка.ВключатьВДоступныеПоля = Истина;
	ПараметрСсылка.ЗапрещатьНезаполненныеЗначения = Истина;
	ПараметрСсылка.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;

	Возврат СКД;

КонецФункции

// Заменяет текст набора данных схемы на актуальный (со звездочкой).
// Переводит схемы, созданные с перечнем реквизитов, на новый текст.
//
// Параметры:
//   СхемаКД - СхемаКомпоновкиДанных - схема, в которой заменяется текст.
//   ПолноеИмяДокумента - Строка - полное имя документа.
//
Процедура ОбновитьТекстНабора(СхемаКД, ПолноеИмяДокумента) Экспорт

	Если СхемаКД.НаборыДанных.Количество() > 0 Тогда
		СхемаКД.НаборыДанных[0].Запрос = ТекстНабораДанных(ПолноеИмяДокумента);
	КонецЕсли;

КонецПроцедуры

// Компилирует правило регистрации документа: компонует схему отбора в готовый запрос.
//
// Параметры:
//   ПолноеИмяДокумента - Строка - полное имя документа.
//   СхемаКД - СхемаКомпоновкиДанных, Неопределено - схема с отборами; Неопределено - отбора нет,
//     правило пропускает все документы типа.
//
// Возвращаемое значение:
//   Структура - результат компиляции:
//     * ТекстЗапроса - Строка - текст запроса, выбирающего Ссылку документов из ПараметрСсылка (массив);
//       пустая строка при ошибке.
//     * ПараметрыЗапроса - Структура - значения параметров запроса, кроме ПараметрСсылка.
//     * ТекстОшибки - Строка - пустая строка при успехе.
//     * СхемаКД - СхемаКомпоновкиДанных - схема с обновленным текстом набора данных.
//
Функция СкомпилироватьПравило(ПолноеИмяДокумента, СхемаКД = Неопределено) Экспорт

	Результат = Новый Структура("ТекстЗапроса, ПараметрыЗапроса, ТекстОшибки, СхемаКД",
		"", Новый Структура, "", СхемаКД);

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		Если СхемаКД = Неопределено Тогда
			Результат.СхемаКД = СхемаОтбораДокумента(ПолноеИмяДокумента);
		КонецЕсли;
		Схема = Результат.СхемаКД;

		ОбновитьТекстНабора(Схема, ПолноеИмяДокумента);

		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
		КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
		// Только с проверкой доступности: Восстановить() без параметра молча отключает недоступные условия.
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);

		НедоступныеПоля = Новый Массив;
		НайтиНедоступныеПоляОтбора(КомпоновщикНастроек.Настройки.Отбор,
			КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора, НедоступныеПоля);
		Если НедоступныеПоля.Количество() > 0 Тогда
			Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Поля отбора отсутствуют в документе: %1'; uk = 'Поля відбору відсутні в документі: %1'"),
				СтрСоединить(НедоступныеПоля, ", "));
			Результат.ТекстЗапроса = "";
			Возврат Результат;
		КонецЕсли;

		Настройки = КомпоновщикНастроек.ПолучитьНастройки();
		ЗаглушкаСсылки = Документы[ИмяДокументаПоПолномуИмени(ПолноеИмяДокумента)].ПолучитьСсылку(
			Новый УникальныйИдентификатор);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПараметрСсылка", ЗаглушкаСсылки);

		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

		Если МакетКомпоновки.НаборыДанных.Количество() <> 1
			Или ТипЗнч(МакетКомпоновки.НаборыДанных[0]) <> Тип("НаборДанныхЗапросМакетаКомпоновкиДанных") Тогда
			ВызватьИсключение НСтр("ru = 'Непредусмотренная структура макета компоновки'; uk = 'Непередбачена структура макета компонування'");
		КонецЕсли;

		ТекстЗапроса = МакетКомпоновки.НаборыДанных[0].Запрос;

		ПараметрыЗапроса = Новый Структура;
		Для Каждого ЗначениеПараметра Из МакетКомпоновки.ЗначенияПараметров Цикл
			Если ЗначениеПараметра.Имя <> "ПараметрСсылка" Тогда
				ПараметрыЗапроса.Вставить(ЗначениеПараметра.Имя, ЗначениеПараметра.Значение);
			КонецЕсли;
		КонецЦикла;

		// Остаточная проверка: текст запроса должен разбираться платформой.
		ПроверочныйЗапрос = Новый Запрос(ТекстЗапроса);
		ПроверочныйЗапрос.НайтиПараметры();

		Результат.ТекстЗапроса = ТекстЗапроса;
		Результат.ПараметрыЗапроса = ПараметрыЗапроса;

	Исключение
		Результат.ТекстЗапроса = "";
		Результат.ПараметрыЗапроса = Новый Структура;
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Компилирует правила регистрации всех строк табличной части ОбъектыКВыгрузке учетной записи обмена.
// Записывает в строки текст запроса, параметры запроса и схему с обновленным текстом набора данных.
//
// Параметры:
//   УчетнаяЗапись - СправочникОбъект.СМП_УчетныеЗаписиОбменов - учетная запись обмена.
//
// Возвращаемое значение:
//   Массив из Строка - тексты ошибок компиляции; пустой массив при успехе.
//
Функция СкомпилироватьПравилаОбъекта(УчетнаяЗапись) Экспорт
	
	Ошибки = Новый Массив;
	
	Для Каждого СтрокаТЧ Из УчетнаяЗапись.ОбъектыКВыгрузке Цикл
		
		СхемаСтроки = СтрокаТЧ.СКДДляОтборов.Получить();
		Если ТипЗнч(СхемаСтроки) <> Тип("СхемаКомпоновкиДанных") Тогда
			СхемаСтроки = Неопределено;
		КонецЕсли;
		
		Результат = СкомпилироватьПравило(СтрокаТЧ.ПолноеИмяОбъекта, СхемаСтроки);
		
		СтрокаТЧ.ТекстЗапроса = Результат.ТекстЗапроса;
		СтрокаТЧ.ПараметрыЗапроса = Новый ХранилищеЗначения(Результат.ПараметрыЗапроса);
		Если СхемаСтроки <> Неопределено Тогда
			СтрокаТЧ.СКДДляОтборов = Новый ХранилищеЗначения(Результат.СхемаКД);
		КонецЕсли;
		
		Если Не ПустаяСтрока(Результат.ТекстОшибки) Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Документ ""%1"": %2'; uk = 'Документ ""%1"": %2'"), СтрокаТЧ.Синоним, Результат.ТекстОшибки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

// Обновляет версию правил регистрации: сбрасывает кеш правил во всех сеансах.
Процедура ОбновитьВерсиюПравил() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Константы.СМП_ВерсияПравилРегистрации.Установить(Строка(Новый УникальныйИдентификатор));
	
КонецПроцедуры

// Перекомпилирует правила регистрации всех активных учетных записей на отправку: перезаписывает
// каждую запись (компиляция выполняется в ПередЗаписью объекта). Записи с ошибкой не записываются.
// Нужна после обновления конфигурации или этого расширения.
//
// Возвращаемое значение:
//   Структура:
//     * Количество - Число - сколько учетных записей перекомпилировано.
//     * Ошибки - Массив из Строка - ошибки по учетным записям, которые не удалось перекомпилировать.
//
Функция ПерекомпилироватьПравила() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Структура("Количество, Ошибки", 0, Новый Массив);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	УчетныеЗаписи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СМП_УчетныеЗаписиОбменов КАК УчетныеЗаписи
	|ГДЕ
	|	НЕ УчетныеЗаписи.ПометкаУдаления
	|	И УчетныеЗаписи.НастройкаОбмена = ЗНАЧЕНИЕ(Перечисление.СМП_НастройкиОбменов.ДляОтправки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УчетныеЗаписи.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		УчетнаяЗапись = Выборка.Ссылка.ПолучитьОбъект();
		Попытка
			УчетнаяЗапись.Записать();
			Результат.Количество = Результат.Количество + 1;
		Исключение
			// Сообщения ПередЗаписью повторяются ниже в общем списке ошибок.
			ПолучитьСообщенияПользователю(Истина);
			Префикс = СтрШаблон(НСтр("ru = 'Учетная запись ""%1"": '; uk = 'Обліковий запис ""%1"": '"), УчетнаяЗапись.Наименование);
			ОшибкиКомпиляции = Неопределено;
			Если УчетнаяЗапись.ДополнительныеСвойства.Свойство("СМП_ОшибкиКомпиляции", ОшибкиКомпиляции) Тогда
				Для Каждого ТекстОшибки Из ОшибкиКомпиляции Цикл
					Результат.Ошибки.Добавить(Префикс + ТекстОшибки);
				КонецЦикла;
			Иначе
				Результат.Ошибки.Добавить(Префикс + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#Область ЧтениеИПрименениеПравил

// Возвращает правила регистрации документа всех активных учетных записей на отправку.
// Результат кешируется по типу документа и версии правил (см. СМП_ОнлайнОбменПовтИсп).
// Версия читается из константы при каждом вызове: функциональные опции в расширении
// недоступны в режиме совместимости ниже 8.3.15 (BAS Бухгалтерия - 8.3.12).
//
// Параметры:
//   ПолноеИмяДокумента - Строка - полное имя документа.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ФиксированнаяСтруктура - см. ПрочитатьПравилаДокумента.
//
Функция ПравилаДокумента(ПолноеИмяДокумента) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Версия = Константы.СМП_ВерсияПравилРегистрации.Получить();

	Возврат СМП_ОнлайнОбменПовтИсп.ПравилаРегистрацииДокумента(ПолноеИмяДокумента, Версия);

КонецФункции

// Читает правила регистрации документа из активных учетных записей на отправку. Без кеша.
//
// Параметры:
//   ПолноеИмяДокумента - Строка - полное имя документа.
//
// Возвращаемое значение:
//   ФиксированныйМассив из ФиксированнаяСтруктура - правила:
//     * УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов
//     * ДатаНачалаВыгрузкиДокументов - Дата
//     * ТекстЗапроса - Строка
//     * ПараметрыЗапроса - ФиксированнаяСтруктура
//     * ТекстОшибки - Строка - пустая строка, если правило применимо.
//
Функция ПрочитатьПравилаДокумента(ПолноеИмяДокумента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(ТекстЗапросаЧтенияПравил() + "
	|ГДЕ
	|	ПОДСТРОКА(Т.ПолноеИмяОбъекта, 1, 200) = &ПолноеИмяДокумента
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|	И Т.Ссылка.НастройкаОбмена = ЗНАЧЕНИЕ(Перечисление.СМП_НастройкиОбменов.ДляОтправки)");
	Запрос.УстановитьПараметр("ПолноеИмяДокумента", ПолноеИмяДокумента);
	
	Правила = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Правила.Добавить(ПравилоИзСтрокиЗапроса(Выборка));
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(Правила);
	
КонецФункции

// Читает правило регистрации документа прямо из учетной записи. Без кеша, без отборов по
// пометке удаления и типу записи.
//
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись обмена.
//   ПолноеИмяДокумента - Строка - полное имя документа.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура, Неопределено - правило (см. ПрочитатьПравилаДокумента); Неопределено,
//   если учетная запись не выгружает документ.
//
Функция ПравилаУчетнойЗаписи(УчетнаяЗапись, ПолноеИмяДокумента) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(ТекстЗапросаЧтенияПравил() + "
	|ГДЕ
	|	Т.Ссылка = &УчетнаяЗапись
	|	И ПОДСТРОКА(Т.ПолноеИмяОбъекта, 1, 200) = &ПолноеИмяДокумента");
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ПолноеИмяДокумента", ПолноеИмяДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ПравилоИзСтрокиЗапроса(Выборка);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает документы массива, проходящие отбор правила. Дату начала выгрузки не проверяет.
//
// Параметры:
//   Правило - ФиксированнаяСтруктура - см. ПрочитатьПравилаДокумента.
//   МассивСсылок - Массив из ДокументСсылка - проверяемые документы.
//
// Возвращаемое значение:
//   Массив из ДокументСсылка - документы, прошедшие отбор.
//
Функция ДокументыПроходящиеОтбор(Правило, МассивСсылок) Экспорт
	
	Если Не ПустаяСтрока(Правило.ТекстОшибки) Тогда
		ВызватьИсключение Правило.ТекстОшибки;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(Правило.ТекстЗапроса);
	Для Каждого Параметр Из Правило.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Запрос.УстановитьПараметр("ПараметрСсылка", МассивСсылок);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Проверяет документ по правилам всех учетных записей на отправку.
//
// Параметры:
//   Ссылка - ДокументСсылка - проверяемый документ.
//   ПолноеИмяДокумента - Строка - полное имя документа.
//   Дата - Дата - дата документа; раньше даты начала выгрузки правило не применяется.
//
// Возвращаемое значение:
//   Структура:
//     * УчетныеЗаписи - Массив из СправочникСсылка.СМП_УчетныеЗаписиОбменов - записи, правила которых документ прошел.
//     * Ошибки - Массив из Структура - не удалось применить правило:
//         ** УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов
//         ** ТекстОшибки - Строка
//
Функция ПроверитьДокумент(Ссылка, ПолноеИмяДокумента, Дата) Экспорт
	
	Результат = Новый Структура("УчетныеЗаписи, Ошибки", Новый Массив, Новый Массив);
	
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(Ссылка);
	
	Для Каждого Правило Из ПравилаДокумента(ПолноеИмяДокумента) Цикл
		
		Если Дата < Правило.ДатаНачалаВыгрузкиДокументов Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Если ДокументыПроходящиеОтбор(Правило, МассивСсылок).Количество() > 0 Тогда
				Результат.УчетныеЗаписи.Добавить(Правило.УчетнаяЗапись);
			КонецЕсли;
		Исключение
			Результат.Ошибки.Добавить(Новый Структура("УчетнаяЗапись, ТекстОшибки", 
				Правило.УчетнаяЗапись, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает имя документа из полного имени.
Функция ИмяДокументаПоПолномуИмени(ПолноеИмяДокумента)

	Возврат СтрРазделить(ПолноеИмяДокумента, ".")[1];

КонецФункции

// Возвращает начало запроса чтения правил из табличной части ОбъектыКВыгрузке (без условий).
Функция ТекстЗапросаЧтенияПравил()
	
	Возврат "ВЫБРАТЬ
	|	Т.Ссылка КАК УчетнаяЗапись,
	|	Т.Ссылка.ДатаНачалаВыгрузкиДокументов КАК ДатаНачалаВыгрузкиДокументов,
	|	Т.ТекстЗапроса КАК ТекстЗапроса,
	|	Т.ПараметрыЗапроса КАК ПараметрыЗапроса
	|ИЗ
	|	Справочник.СМП_УчетныеЗаписиОбменов.ОбъектыКВыгрузке КАК Т";
	
КонецФункции

// Собирает правило из строки результата запроса чтения правил, проверяя его текст.
Функция ПравилоИзСтрокиЗапроса(Строка)
	
	ТекстОшибки = ПроверитьТекстПравила(Строка.ТекстЗапроса);
	
	ПараметрыЗапроса = Строка.ПараметрыЗапроса.Получить();
	Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда
		ПараметрыЗапроса = Новый Структура;
	КонецЕсли;
	
	Правило = Новый Структура;
	Правило.Вставить("УчетнаяЗапись", Строка.УчетнаяЗапись);
	Правило.Вставить("ДатаНачалаВыгрузкиДокументов", Строка.ДатаНачалаВыгрузкиДокументов);
	Правило.Вставить("ТекстЗапроса", Строка.ТекстЗапроса);
	Правило.Вставить("ТекстОшибки", ТекстОшибки);
	Попытка
		Правило.Вставить("ПараметрыЗапроса", Новый ФиксированнаяСтруктура(ПараметрыЗапроса));
	Исключение
		Правило.Вставить("ПараметрыЗапроса", Новый ФиксированнаяСтруктура);
		Если ПустаяСтрока(ТекстОшибки) Тогда
			Правило.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
	КонецПопытки;
	
	Возврат Новый ФиксированнаяСтруктура(Правило);
	
КонецФункции

// Проверяет текст скомпилированного правила; возвращает текст ошибки или пустую строку.
Функция ПроверитьТекстПравила(ТекстЗапроса)
	
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат НСтр("ru = 'Правила регистрации не скомпилированы: выполните команду ""Перекомпилировать правила регистрации"" в списке учетных записей обмена.'; uk = 'Правила реєстрації не скомпільовано: виконайте команду ""Перекомпилировать правила регистрации"" у списку облікових записів обміну.'");
	КонецЕсли;
	
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.НайтиПараметры();
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

// Рекурсивно собирает поля элементов отбора, которых нет среди доступных полей отбора.
//
// Параметры:
//   Отбор - ОтборКомпоновкиДанных, ГруппаЭлементовОтбораКомпоновкиДанных - обходимый отбор.
//   ДоступныеПоля - ДоступныеПоляОтбораКомпоновкиДанных - доступные поля отбора настроек.
//   НедоступныеПоля - Массив - собранные пути полей (Строка).
//
Процедура НайтиНедоступныеПоляОтбора(Отбор, ДоступныеПоля, НедоступныеПоля)

	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НайтиНедоступныеПоляОтбора(Элемент, ДоступныеПоля, НедоступныеПоля);
		ИначеЕсли ТипЗнч(Элемент.ЛевоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
			Если ДоступныеПоля.НайтиПоле(Элемент.ЛевоеЗначение) = Неопределено Тогда
				ПутьПоля = Строка(Элемент.ЛевоеЗначение);
				Если НедоступныеПоля.Найти(ПутьПоля) = Неопределено Тогда
					НедоступныеПоля.Добавить(ПутьПоля);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
