
#Область ПрограммныйИнтерфейс

// Возвращает текст набора данных схемы компоновки данных для отбора документов.
// Текст выбирает все реквизиты и табличные части документа (звездочка), поэтому не содержит
// имен реквизитов и не устаревает при изменении метаданных.
//
// Параметры:
//   ПолноеИмяДокумента - Строка - полное имя документа, например "Документ.РасходнаяНакладная".
//
// Возвращаемое значение:
//   Строка - текст запроса набора данных.
//
Функция ТекстНабораДанных(ПолноеИмяДокумента) Экспорт

	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ" + Символы.ПС
		+ Символы.Таб + "*" + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ Символы.Таб + ПолноеИмяДокумента + " КАК ОБ" + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ Символы.Таб + "ОБ.Ссылка В (&ПараметрСсылка)";

КонецФункции

// Возвращает схему компоновки данных для отбора документов при регистрации в очереди.
//
// Параметры:
//   ПолноеИмяДокумента - Строка - полное имя документа, например "Документ.РасходнаяНакладная".
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных - схема с одним набором данных и параметром ПараметрСсылка.
//
Функция СхемаОтбораДокумента(ПолноеИмяДокумента) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	СКД = Новый СхемаКомпоновкиДанных;

	ИсточникДанных = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "local";

	НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = ПолноеИмяДокумента;
	НаборДанных.Запрос = ТекстНабораДанных(ПолноеИмяДокумента);
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;

	ПолеСсылка = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеСсылка.Заголовок = "Ссылка";
	ПолеСсылка.Использование = Истина;
	ПолеСсылка.Поле = Новый ПолеКомпоновкиДанных("Ссылка");

	ГруппировкаСКД = СКД.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСКД.Использование = Истина;

	АвтоВыбранныеПоля = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	АвтоВыбранныеПоля.Использование = Истина;

	ВыбранныеПоляПорядка = ГруппировкаСКД.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	ВыбранныеПоляПорядка.Использование = Истина;

	ПараметрСсылка = СКД.Параметры.Добавить();
	ПараметрСсылка.Имя = "ПараметрСсылка";
	ПараметрСсылка.Заголовок = " Ссылка на документ";
	ПараметрСсылка.ТипЗначения = Новый ОписаниеТипов("ДокументСсылка." + ИмяДокументаПоПолномуИмени(ПолноеИмяДокумента));
	ПараметрСсылка.ВключатьВДоступныеПоля = Истина;
	ПараметрСсылка.ЗапрещатьНезаполненныеЗначения = Истина;
	ПараметрСсылка.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;

	Возврат СКД;

КонецФункции

// Заменяет текст набора данных схемы на актуальный (со звездочкой).
// Переводит схемы, созданные с перечнем реквизитов, на новый текст.
//
// Параметры:
//   СхемаКД - СхемаКомпоновкиДанных - схема, в которой заменяется текст.
//   ПолноеИмяДокумента - Строка - полное имя документа.
//
Процедура ОбновитьТекстНабора(СхемаКД, ПолноеИмяДокумента) Экспорт

	Если СхемаКД.НаборыДанных.Количество() > 0 Тогда
		СхемаКД.НаборыДанных[0].Запрос = ТекстНабораДанных(ПолноеИмяДокумента);
	КонецЕсли;

КонецПроцедуры

// Компилирует правило регистрации документа: компонует схему отбора в готовый запрос.
//
// Параметры:
//   ПолноеИмяДокумента - Строка - полное имя документа.
//   СхемаКД - СхемаКомпоновкиДанных, Неопределено - схема с отборами; Неопределено - отбора нет,
//     правило пропускает все документы типа.
//
// Возвращаемое значение:
//   Структура - результат компиляции:
//     * ТекстЗапроса - Строка - текст запроса, выбирающего Ссылку документов из ПараметрСсылка (массив);
//       пустая строка при ошибке.
//     * ПараметрыЗапроса - Структура - значения параметров запроса, кроме ПараметрСсылка.
//     * ТекстОшибки - Строка - пустая строка при успехе.
//     * СхемаКД - СхемаКомпоновкиДанных - схема с обновленным текстом набора данных.
//
Функция СкомпилироватьПравило(ПолноеИмяДокумента, СхемаКД = Неопределено) Экспорт

	Результат = Новый Структура("ТекстЗапроса, ПараметрыЗапроса, ТекстОшибки, СхемаКД",
		"", Новый Структура, "", СхемаКД);

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		Если СхемаКД = Неопределено Тогда
			Результат.СхемаКД = СхемаОтбораДокумента(ПолноеИмяДокумента);
		КонецЕсли;
		Схема = Результат.СхемаКД;

		ОбновитьТекстНабора(Схема, ПолноеИмяДокумента);

		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
		КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
		// Только с проверкой доступности: Восстановить() без параметра молча отключает недоступные условия.
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);

		НедоступныеПоля = Новый Массив;
		НайтиНедоступныеПоляОтбора(КомпоновщикНастроек.Настройки.Отбор,
			КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора, НедоступныеПоля);
		Если НедоступныеПоля.Количество() > 0 Тогда
			Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Поля отбора отсутствуют в документе: %1'"),
				СтрСоединить(НедоступныеПоля, ", "));
			Результат.ТекстЗапроса = "";
			Возврат Результат;
		КонецЕсли;

		Настройки = КомпоновщикНастроек.ПолучитьНастройки();
		ЗаглушкаСсылки = Документы[ИмяДокументаПоПолномуИмени(ПолноеИмяДокумента)].ПолучитьСсылку(
			Новый УникальныйИдентификатор);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПараметрСсылка", ЗаглушкаСсылки);

		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

		Если МакетКомпоновки.НаборыДанных.Количество() <> 1
			Или ТипЗнч(МакетКомпоновки.НаборыДанных[0]) <> Тип("НаборДанныхЗапросМакетаКомпоновкиДанных") Тогда
			ВызватьИсключение НСтр("ru = 'Непредусмотренная структура макета компоновки'");
		КонецЕсли;

		ТекстЗапроса = МакетКомпоновки.НаборыДанных[0].Запрос;

		ПараметрыЗапроса = Новый Структура;
		Для Каждого ЗначениеПараметра Из МакетКомпоновки.ЗначенияПараметров Цикл
			Если ЗначениеПараметра.Имя <> "ПараметрСсылка" Тогда
				ПараметрыЗапроса.Вставить(ЗначениеПараметра.Имя, ЗначениеПараметра.Значение);
			КонецЕсли;
		КонецЦикла;

		// Остаточная проверка: текст запроса должен разбираться платформой.
		ПроверочныйЗапрос = Новый Запрос(ТекстЗапроса);
		ПроверочныйЗапрос.НайтиПараметры();

		Результат.ТекстЗапроса = ТекстЗапроса;
		Результат.ПараметрыЗапроса = ПараметрыЗапроса;

	Исключение
		Результат.ТекстЗапроса = "";
		Результат.ПараметрыЗапроса = Новый Структура;
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает имя документа из полного имени.
Функция ИмяДокументаПоПолномуИмени(ПолноеИмяДокумента)

	Возврат СтрРазделить(ПолноеИмяДокумента, ".")[1];

КонецФункции

// Рекурсивно собирает поля элементов отбора, которых нет среди доступных полей отбора.
//
// Параметры:
//   Отбор - ОтборКомпоновкиДанных, ГруппаЭлементовОтбораКомпоновкиДанных - обходимый отбор.
//   ДоступныеПоля - ДоступныеПоляОтбораКомпоновкиДанных - доступные поля отбора настроек.
//   НедоступныеПоля - Массив - собранные пути полей (Строка).
//
Процедура НайтиНедоступныеПоляОтбора(Отбор, ДоступныеПоля, НедоступныеПоля)

	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			НайтиНедоступныеПоляОтбора(Элемент, ДоступныеПоля, НедоступныеПоля);
		ИначеЕсли ТипЗнч(Элемент.ЛевоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
			Если ДоступныеПоля.НайтиПоле(Элемент.ЛевоеЗначение) = Неопределено Тогда
				ПутьПоля = Строка(Элемент.ЛевоеЗначение);
				Если НедоступныеПоля.Найти(ПутьПоля) = Неопределено Тогда
					НедоступныеПоля.Добавить(ПутьПоля);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
