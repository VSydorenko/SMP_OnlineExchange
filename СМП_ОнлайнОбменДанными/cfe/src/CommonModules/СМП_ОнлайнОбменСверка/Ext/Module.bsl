#Область ПравилаСверки

// Возвращает описание объекта метаданных той базы, в которой выполняется код:
// для учетной записи ДляОтправки - источник ПКО, для ДляПолучения - приемник ПКО.
//
// Параметры:
//   ПКО - СправочникСсылка.ПравилаКонвертацииОбъектов - правило, которому подчинено правило сверки.
//
// Возвращаемое значение:
//   СправочникСсылка.Объекты - объект своей базы; пустая ссылка, если ПКО не указано.
//
Функция ОбъектСвоейБазы(ПКО) Экспорт
	
	Если Не ЗначениеЗаполнено(ПКО) Тогда
		Возврат Справочники.Объекты.ПустаяСсылка();
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПКО,
		Новый Структура("Источник, Приемник, НастройкаОбмена", "Источник", "Приемник", "Владелец.НастройкаОбмена"));
	
	Если Реквизиты.НастройкаОбмена = Перечисления.СМП_НастройкиОбменов.ДляПолучения Тогда
		Возврат Реквизиты.Приемник;
	КонецЕсли;
	
	Возврат Реквизиты.Источник;
	
КонецФункции // ОбъектСвоейБазы

// Проверяет, есть ли среди типов свойства (описание метаданных КД2) ссылочный тип.
//
// Параметры:
//   Свойство - СправочникСсылка.Свойства - реквизит объекта метаданных.
//
// Возвращаемое значение:
//   Булево - Истина, если хотя бы один тип свойства - ссылка ("СправочникСсылка.Х", "ПеречислениеСсылка.Х" и т.п.).
//
Функция СвойствоИмеетСсылочныйТип(Свойство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Признак
	|ИЗ
	|	Справочник.Свойства.Типы КАК Типы
	|ГДЕ
	|	Типы.Ссылка = &Свойство
	|	И Типы.Тип.Наименование ПОДОБНО ""%Ссылка.%""";
	Запрос.УстановитьПараметр("Свойство", Свойство);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции // СвойствоИмеетСсылочныйТип

#КонецОбласти

#Область ВычислениеПоказателей

// Возвращает действующие правила сверки ПКО.
//
// Параметры:
//   ПКО - СправочникСсылка.ПравилаКонвертацииОбъектов - владелец правил.
//   КодыПоказателей - Массив из Строка, Неопределено - отбор по кодам; Неопределено - все правила.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: Код, Наименование, Вид, ИмяРеквизита, Выражение, Допуск, Информативный, Порядок.
//
Функция ПравилаСверки(ПКО, КодыПоказателей = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Код КАК Код,
	|	Правила.Наименование КАК Наименование,
	|	Правила.Вид КАК Вид,
	|	Правила.Реквизит.Наименование КАК ИмяРеквизита,
	|	Правила.Выражение КАК Выражение,
	|	Правила.Допуск КАК Допуск,
	|	Правила.Информативный КАК Информативный,
	|	Правила.Порядок КАК Порядок
	|ИЗ
	|	Справочник.СМП_ПравилаСверки КАК Правила
	|ГДЕ
	|	Правила.Владелец = &ПКО
	|	И НЕ Правила.ПометкаУдаления
	|	И НЕ Правила.Отключить
	|	И (НЕ &ОтборПоКодам
	|			ИЛИ Правила.Код В (&КодыПоказателей))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Код";
	Запрос.УстановитьПараметр("ПКО", ПКО);
	Запрос.УстановитьПараметр("ОтборПоКодам", КодыПоказателей <> Неопределено);
	Запрос.УстановитьПараметр("КодыПоказателей", ?(КодыПоказателей = Неопределено, Новый Массив, КодыПоказателей));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПравилаСверки

// Вычисляет показатели объекта по правилам сверки. Ошибка одного показателя не прерывает остальные.
//
// Параметры:
//   Объект - ДокументОбъект - объект, для которого вычисляются показатели.
//   Правила - ТаблицаЗначений - см. ПравилаСверки().
//
// Возвращаемое значение:
//   Соответствие - ключ: код показателя; значение: Структура со свойством Значение
//                  (см. НормализоватьЗначение()) или Ошибка (Строка).
//
Функция ВычислитьПоказатели(Объект, Правила) Экспорт
	
	Результат = Новый Соответствие;
	
	Для Каждого Правило Из Правила Цикл
		
		Попытка
			
			Если Правило.Вид = Перечисления.СМП_ВидыПоказателейСверки.Реквизит Тогда
				Значение = Объект[Правило.ИмяРеквизита];
			Иначе
				Значение = ВычислитьВыражение(Объект, Правило.Выражение);
			КонецЕсли;
			
			Если Не Правило.Информативный И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
				ВызватьИсключение НСтр("ru = 'Показатель вернул ссылку: сверять ссылки можно только как информативный показатель.'");
			КонецЕсли;
			
			Результат.Вставить(Правило.Код, Новый Структура("Значение", НормализоватьЗначение(Значение)));
			
		Исключение
			
			Результат.Вставить(Правило.Код, Новый Структура("Ошибка", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ВычислитьПоказатели

// Вычисляет показатели документа по ссылке; если объект прочитать не удалось - ошибка на каждом показателе.
//
// Параметры:
//   Ссылка - ДокументСсылка - документ.
//   Правила - ТаблицаЗначений - см. ПравилаСверки().
//
// Возвращаемое значение:
//   Соответствие - см. ВычислитьПоказатели().
//
Функция ВычислитьПоказателиДокумента(Ссылка, Правила) Экспорт
	
	Если Правила.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Объект = Неопределено;
	ТекстОшибки = Неопределено;
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Объект = Неопределено Тогда
		Если ТекстОшибки = Неопределено Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось прочитать документ.'");
		КонецЕсли;
		Результат = Новый Соответствие;
		Для Каждого Правило Из Правила Цикл
			Результат.Вставить(Правило.Код, Новый Структура("Ошибка", ТекстОшибки));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
	Возврат ВычислитьПоказатели(Объект, Правила);
	
КонецФункции // ВычислитьПоказателиДокумента

// Сравнивает нормализованные значения показателя источника и приемника.
// Разные типы (в т.ч. пустое значение против 0) - расхождение; числа - с допуском; строки, даты, булево - точно.
//
// Параметры:
//   ЗначениеИсточник - Число, Строка, Булево, Неопределено - см. НормализоватьЗначение().
//   ЗначениеПриемник - Число, Строка, Булево, Неопределено - значение из ответа приемника.
//   Допуск - Число - допустимая разница для чисел.
//
// Возвращаемое значение:
//   Булево - Истина, если значения совпадают.
//
Функция ЗначенияСовпадают(ЗначениеИсточник, ЗначениеПриемник, Допуск) Экспорт
	
	Если ТипЗнч(ЗначениеИсточник) <> ТипЗнч(ЗначениеПриемник) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеИсточник) = Тип("Число") Тогда
		Разница = ЗначениеИсточник - ЗначениеПриемник;
		Возврат Макс(Разница, -Разница) <= Допуск;
	КонецЕсли;
	
	Возврат ЗначениеИсточник = ЗначениеПриемник;
	
КонецФункции // ЗначенияСовпадают

// Приводит значение показателя к виду, пригодному для JSON и сравнения между базами.
//
// Параметры:
//   Значение - Произвольный - вычисленное значение.
//
// Возвращаемое значение:
//   Число, Булево - как есть; Строка - без концевых пробелов; дата - строкой XMLСтрока;
//   Неопределено - для Неопределено и Null; прочее - представление строкой.
//
Функция НормализоватьЗначение(Значение) Экспорт
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции // НормализоватьЗначение

// Вычисляет выражение правила в безопасном режиме. В выражении доступна переменная Объект.
// Безопасный режим выключается автоматически при выходе из функции.
//
// Параметры:
//   Объект - ДокументОбъект - контекст выражения.
//   Выражение - Строка - выражение встроенного языка (одно выражение, без операторов).
//
// Возвращаемое значение:
//   Произвольный - результат выражения.
//
Функция ВычислитьВыражение(Объект, Выражение)
	
	УстановитьБезопасныйРежим(Истина);
	Возврат Вычислить(Выражение);
	
КонецФункции // ВычислитьВыражение

#КонецОбласти

#Область ОбработкаЗапросаСверки

// Версия контракта /validate, которую понимает эта версия расширения.
//
// Возвращаемое значение:
//   Число
//
Функция ВерсияКонтракта() Экспорт
	
	Возврат 1;
	
КонецФункции // ВерсияКонтракта

// Версия контракта /validate, в которой база отвечает как источник на запросы приемника.
//
// Возвращаемое значение:
//   Число
//
Функция ВерсияКонтрактаИсточника() Экспорт

	Возврат 2;

КонецФункции // ВерсияКонтрактаИсточника

// Имя события журнала регистрации для ошибок сверки.
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяСобытияЖурнала() Экспорт
	
	Возврат НСтр("ru = 'СМП_ОнлайнОбмен.Сверка'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции // ИмяСобытияЖурнала

// Формирует ответ сервиса с ошибкой уровня запроса.
//
// Параметры:
//   КодСостояния - Число - код HTTP.
//   ТекстОшибки - Строка - текст для вызывающей стороны.
//   Версия - Число, Неопределено - версия контракта в теле ответа; Неопределено - ВерсияКонтракта().
//
// Возвращаемое значение:
//   Структура - КодСостояния (Число), Тело (Соответствие: Версия, Ошибка).
//
Функция ОтветОшибки(КодСостояния, ТекстОшибки, Версия = Неопределено) Экспорт

	Тело = Новый Соответствие;
	Тело.Вставить("Версия", ?(Версия = Неопределено, ВерсияКонтракта(), Версия));
	Тело.Вставить("Ошибка", ТекстОшибки);
	
	Возврат Новый Структура("КодСостояния, Тело", КодСостояния, Тело);
	
КонецФункции // ОтветОшибки

// Обрабатывает запрос /validate/{ИдентификаторОбмена}: версия контракта выбирает роль базы.
// Версия 1 - база отвечает как приемник (запись ДляПолучения), версия 2 - как источник (запись ДляОтправки).
//
// Параметры:
//   ИдентификаторОбмена - Строка - идентификатор обмена из URL.
//   ТелоЗапроса - Строка - JSON запроса (уже распакованный из gzip).
//
// Возвращаемое значение:
//   Структура - КодСостояния (Число), Тело (Соответствие).
//
Функция ОбработатьЗапросValidate(ИдентификаторОбмена, ТелоЗапроса) Экспорт

	Попытка
		ДанныеЗапроса = СМП_КоннекторHTTP.JsonВОбъект(ТелоЗапроса);
	Исключение
		Возврат ОтветОшибки(400, НСтр("ru = 'Тело запроса сверки не является корректным JSON.'"));
	КонецПопытки;

	Если ТипЗнч(ДанныеЗапроса) <> Тип("Соответствие") Тогда
		Возврат ОтветОшибки(400, НСтр("ru = 'Тело запроса сверки должно быть объектом JSON.'"));
	КонецЕсли;

	Версия = ДанныеЗапроса.Получить("Версия");

	Если Версия = ВерсияКонтракта() Тогда

		УчетнаяЗапись = СМП_ОнлайнОбменПовтИсп.ПолучитьУчетнуюЗаписьОбменаПоИд(ИдентификаторОбмена, Истина);
		Если УчетнаяЗапись = Неопределено Тогда
			Возврат ОтветОшибки(404,
				"В базе-приемнике не найдена учетная запись обмена с идентификатором """ + ИдентификаторОбмена + """.");
		КонецЕсли;
		Возврат ОбработатьЗапросСверки(УчетнаяЗапись, ТелоЗапроса);

	ИначеЕсли Версия = ВерсияКонтрактаИсточника() Тогда

		УчетнаяЗапись = СМП_ОнлайнОбменПовтИсп.ПолучитьУчетнуюЗаписьОбменаПоИд(ИдентификаторОбмена, Ложь);
		Если УчетнаяЗапись = Неопределено Тогда
			Возврат ОтветОшибки(404, СтрШаблон(
				НСтр("ru = 'В базе-источнике не найдена учетная запись обмена ""Для отправки"" с идентификатором ""%1"".'"),
				ИдентификаторОбмена), ВерсияКонтрактаИсточника());
		КонецЕсли;
		Возврат ОбработатьЗапросИсточнику(УчетнаяЗапись, ДанныеЗапроса);

	КонецЕсли;

	Ответ = ОтветОшибки(400, СтрШаблон(
		НСтр("ru = 'Версия контракта сверки ""%1"" не поддерживается.'"), Версия));
	ПоддерживаемыеВерсии = Новый Массив;
	ПоддерживаемыеВерсии.Добавить(ВерсияКонтракта());
	ПоддерживаемыеВерсии.Добавить(ВерсияКонтрактаИсточника());
	Ответ.Тело.Вставить("ПоддерживаемыеВерсии", ПоддерживаемыеВерсии);
	Возврат Ответ;

КонецФункции // ОбработатьЗапросValidate

// Обрабатывает запрос сверки в базе-приемнике (контракт - спецификация, раздел 3б).
//
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляПолучения.
//   ТелоЗапроса - Строка - JSON запроса (уже распакованный из gzip).
//
// Возвращаемое значение:
//   Структура - КодСостояния (Число), Тело (Соответствие).
//
Функция ОбработатьЗапросСверки(УчетнаяЗапись, ТелоЗапроса) Экспорт
	
	Попытка
		ДанныеЗапроса = СМП_КоннекторHTTP.JsonВОбъект(ТелоЗапроса);
	Исключение
		Возврат ОтветОшибки(400, НСтр("ru = 'Тело запроса сверки не является корректным JSON.'"));
	КонецПопытки;
	
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Соответствие") Тогда
		Возврат ОтветОшибки(400, НСтр("ru = 'Тело запроса сверки должно быть объектом JSON.'"));
	КонецЕсли;
	
	Версия = ДанныеЗапроса.Получить("Версия");
	Если Версия <> ВерсияКонтракта() Тогда
		Ответ = ОтветОшибки(400, СтрШаблон(
			НСтр("ru = 'Версия контракта сверки ""%1"" не поддерживается приемником.'"), Версия));
		ПоддерживаемыеВерсии = Новый Массив;
		ПоддерживаемыеВерсии.Добавить(ВерсияКонтракта());
		Ответ.Тело.Вставить("ПоддерживаемыеВерсии", ПоддерживаемыеВерсии);
		Возврат Ответ;
	КонецЕсли;
	
	ИмяПравила = ДанныеЗапроса.Получить("ИмяПравила");
	КодыПоказателей = ДанныеЗапроса.Получить("Показатели");
	ИдентификаторыОбъектов = ДанныеЗапроса.Получить("Объекты");
	Если ТипЗнч(ИмяПравила) <> Тип("Строка")
		Или ТипЗнч(КодыПоказателей) <> Тип("Массив")
		Или ТипЗнч(ИдентификаторыОбъектов) <> Тип("Массив") Тогда
		Возврат ОтветОшибки(400,
			НСтр("ru = 'В запросе сверки нужны ""ИмяПравила"" (строка), ""Показатели"" и ""Объекты"" (массивы).'"));
	КонецЕсли;
	
	ПКО = НайтиПКОПоКоду(УчетнаяЗапись, ИмяПравила);
	Если ПКО = Неопределено Тогда
		Возврат ОтветОшибки(422, СтрШаблон(
			НСтр("ru = 'В приемнике нет правила конвертации объектов с кодом ""%1"".'"), ИмяПравила));
	КонецЕсли;
	
	МетаданныеДокумента = МетаданныеДокументаПоТипу(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПКО, "ТипПриемника"));
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат ОтветОшибки(422, СтрШаблон(
			НСтр("ru = 'Правило ""%1"" в приемнике конвертирует не документ.'"), ИмяПравила));
	КонецЕсли;
	
	Правила = ПравилаСверки(ПКО, КодыПоказателей);
	МенеджерДокумента = Документы[МетаданныеДокумента.Имя];
	
	Ссылки = Новый Массив;
	СсылкиПоИдентификатору = Новый Соответствие;
	Для Каждого Идентификатор Из ИдентификаторыОбъектов Цикл
		Попытка
			Ссылка = МенеджерДокумента.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		Исключение
			Продолжить;
		КонецПопытки;
		Ссылки.Добавить(Ссылка);
		СсылкиПоИдентификатору.Вставить(Идентификатор, Ссылка);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.Проведен КАК Проведен,
	|	Т.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	%1 КАК Т
	|ГДЕ
	|	Т.Ссылка В (&Ссылки)", МетаданныеДокумента.ПолноеИмя());
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Состояния = Запрос.Выполнить().Выгрузить();
	Состояния.Индексы.Добавить("Ссылка");
	
	ОбъектыОтвета = Новый Массив;
	Для Каждого Идентификатор Из ИдентификаторыОбъектов Цикл
		
		Элемент = Новый Соответствие;
		Элемент.Вставить("УникальныйИдентификатор", Идентификатор);
		
		Ссылка = СсылкиПоИдентификатору.Получить(Идентификатор);
		Если Ссылка = Неопределено Тогда
			Элемент.Вставить("Найден", Ложь);
			Элемент.Вставить("Ошибка", НСтр("ru = 'Некорректный уникальный идентификатор.'"));
			ОбъектыОтвета.Добавить(Элемент);
			Продолжить;
		КонецЕсли;
		
		Состояние = Состояния.Найти(Ссылка, "Ссылка");
		Если Состояние = Неопределено Тогда
			Элемент.Вставить("Найден", Ложь);
			ОбъектыОтвета.Добавить(Элемент);
			Продолжить;
		КонецЕсли;
		
		Элемент.Вставить("Найден", Истина);
		Элемент.Вставить("Тип", МетаданныеДокумента.ПолноеИмя());
		Элемент.Вставить("Номер", Строка(Состояние.Номер));
		Элемент.Вставить("Дата", XMLСтрока(Состояние.Дата));
		Элемент.Вставить("Проведен", Состояние.Проведен);
		Элемент.Вставить("ПометкаУдаления", Состояние.ПометкаУдаления);
		Элемент.Вставить("Показатели", ПоказателиДляОтвета(Ссылка, Правила, КодыПоказателей));
		ОбъектыОтвета.Добавить(Элемент);
		
	КонецЦикла;
	
	Тело = Новый Соответствие;
	Тело.Вставить("Версия", ВерсияКонтракта());
	Тело.Вставить("ИмяПравила", ИмяПравила);
	Тело.Вставить("Объекты", ОбъектыОтвета);
	
	Возврат Новый Структура("КодСостояния, Тело", 200, Тело);
	
КонецФункции // ОбработатьЗапросСверки

Функция НайтиПКОПоКоду(УчетнаяЗапись, Код)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПКО.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов КАК ПКО
	|ГДЕ
	|	ПКО.Владелец = &УчетнаяЗапись
	|	И ПКО.Код = &Код
	|	И НЕ ПКО.ЭтоГруппа
	|	И НЕ ПКО.ПометкаУдаления";
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("Код", Код);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции // НайтиПКОПоКоду

Функция МетаданныеДокументаПоТипу(ТипСтрокой)
	
	Префикс = "ДокументСсылка.";
	Если ТипЗнч(ТипСтрокой) <> Тип("Строка") Или Не СтрНачинаетсяС(ТипСтрокой, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Метаданные.Документы.Найти(Сред(ТипСтрокой, СтрДлина(Префикс) + 1));
	
КонецФункции // МетаданныеДокументаПоТипу

Функция ПоказателиДляОтвета(Ссылка, Правила, КодыПоказателей)
	
	Вычисленные = ВычислитьПоказателиДокумента(Ссылка, Правила);
	
	Результат = Новый Соответствие;
	Для Каждого Код Из КодыПоказателей Цикл
		
		КодСтрокой = Строка(Код);
		Показатель = Новый Соответствие;
		Вычисленный = Вычисленные.Получить(КодСтрокой);
		Если Вычисленный = Неопределено Тогда
			Показатель.Вставить("НеНастроен", Истина);
		ИначеЕсли Вычисленный.Свойство("Ошибка") Тогда
			Показатель.Вставить("Ошибка", Вычисленный.Ошибка);
		Иначе
			Показатель.Вставить("Значение", Вычисленный.Значение);
		КонецЕсли;
		Результат.Вставить(КодСтрокой, Показатель);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПоказателиДляОтвета

#КонецОбласти

#Область ЗапросыКИсточнику

// Обрабатывает запрос приемника к базе-источнику (контракт версии 2): "Эталон" или "ПоискПоGUID".
//
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляОтправки.
//   ДанныеЗапроса - Соответствие - разобранный JSON запроса.
//
// Возвращаемое значение:
//   Структура - КодСостояния (Число), Тело (Соответствие).
//
Функция ОбработатьЗапросИсточнику(УчетнаяЗапись, ДанныеЗапроса)

	ВидЗапроса = ДанныеЗапроса.Получить("Запрос");
	Если ВидЗапроса = "Эталон" Тогда
		Возврат ОтветЭталон(УчетнаяЗапись, ДанныеЗапроса);
	ИначеЕсли ВидЗапроса = "ПоискПоGUID" Тогда
		Возврат ОтветПоискПоGUID(УчетнаяЗапись, ДанныеЗапроса);
	КонецЕсли;

	Возврат ОтветОшибки(400, СтрШаблон(НСтр("ru = 'Неизвестный вид запроса сверки ""%1"".'"), ВидЗапроса),
		ВерсияКонтрактаИсточника());

КонецФункции // ОбработатьЗапросИсточнику

// Формирует ответ на запрос "Эталон": документы источника за период по каждому правилу запроса
// (тот же набор, что и в сверке источника) с показателями по кодам приемника.
//
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляОтправки.
//   ДанныеЗапроса - Соответствие - Правила (Массив из Соответствие: ИмяПравила, Показатели),
//                   НачалоПериода, КонецПериода (дата XML).
//
// Возвращаемое значение:
//   Структура - КодСостояния (Число), Тело (Соответствие: Версия, Объекты).
//
Функция ОтветЭталон(УчетнаяЗапись, ДанныеЗапроса)

	Версия = ВерсияКонтрактаИсточника();
	ТекстОшибкиСтруктуры = НСтр("ru = 'В запросе ""Эталон"" нужны ""Правила"" (массив), ""НачалоПериода"" и ""КонецПериода"" (дата XML).'");

	ПравилаЗапроса = ДанныеЗапроса.Получить("Правила");
	Если ТипЗнч(ПравилаЗапроса) <> Тип("Массив") Тогда
		Возврат ОтветОшибки(400, ТекстОшибкиСтруктуры, Версия);
	КонецЕсли;

	Попытка
		НачалоПериода = XMLЗначение(Тип("Дата"), ДанныеЗапроса.Получить("НачалоПериода"));
		КонецПериода = XMLЗначение(Тип("Дата"), ДанныеЗапроса.Получить("КонецПериода"));
	Исключение
		Возврат ОтветОшибки(400, ТекстОшибкиСтруктуры, Версия);
	КонецПопытки;

	Для Каждого ПравилоЗапроса Из ПравилаЗапроса Цикл
		Если ТипЗнч(ПравилоЗапроса) <> Тип("Соответствие")
			Или ТипЗнч(ПравилоЗапроса.Получить("ИмяПравила")) <> Тип("Строка")
			Или ТипЗнч(ПравилоЗапроса.Получить("Показатели")) <> Тип("Массив") Тогда
			Возврат ОтветОшибки(400, ТекстОшибкиСтруктуры, Версия);
		КонецЕсли;
	КонецЦикла;

	// Сначала проверяются все правила: ошибка любого - ответ 422 без данных.
	ОбменОбъект = УчетнаяЗапись.ПолучитьОбъект();
	ОписанияПравил = Новый Массив;
	ПравилаПоТипу = Новый Соответствие;
	Для Каждого ПравилоЗапроса Из ПравилаЗапроса Цикл

		ИмяПравила = ПравилоЗапроса.Получить("ИмяПравила");
		Описание = ПравилоИсточника(ОбменОбъект, ИмяПравила);
		Если ЗначениеЗаполнено(Описание.ТекстОшибки) Тогда
			Возврат ОтветОшибки(422, Описание.ТекстОшибки, Версия);
		КонецЕсли;

		ПолноеИмя = Описание.МетаданныеДокумента.ПолноеИмя();
		Если ПравилаПоТипу.Получить(ПолноеИмя) <> Неопределено Тогда
			Возврат ОтветОшибки(422, СтрШаблон(
				НСтр("ru = 'Несколько правил запроса для документа ""%1"" - такая сверка не поддерживается.'"),
				Описание.МетаданныеДокумента.Представление()), Версия);
		КонецЕсли;
		ПравилаПоТипу.Вставить(ПолноеИмя, ИмяПравила);

		Описание.Вставить("ИмяПравила", ИмяПравила);
		Описание.Вставить("Показатели", ПравилоЗапроса.Получить("Показатели"));
		ОписанияПравил.Добавить(Описание);

	КонецЦикла;

	ПараметрыНабора = Новый Структура("УчетнаяЗапись, НачалоПериода, КонецПериода",
		УчетнаяЗапись, НачалоПериода, КонецПериода);

	ОбъектыОтвета = Новый Массив;
	Для Каждого Описание Из ОписанияПравил Цикл

		Состояния = ЭталонныйНабор(ПараметрыНабора, Описание.МетаданныеДокумента);
		Правила = ПравилаСверки(Описание.ПКО, Описание.Показатели);
		ПолноеИмя = Описание.МетаданныеДокумента.ПолноеИмя();

		Для Каждого Состояние Из Состояния Цикл
			Элемент = Новый Соответствие;
			Элемент.Вставить("УникальныйИдентификатор", Строка(Состояние.Ссылка.УникальныйИдентификатор()));
			Элемент.Вставить("ИмяПравила", Описание.ИмяПравила);
			Элемент.Вставить("Тип", ПолноеИмя);
			Элемент.Вставить("Номер", Строка(Состояние.Номер));
			Элемент.Вставить("Дата", XMLСтрока(Состояние.Дата));
			Элемент.Вставить("Проведен", Состояние.Проведен);
			Элемент.Вставить("ПометкаУдаления", Состояние.ПометкаУдаления);
			Элемент.Вставить("Показатели", ПоказателиДляОтвета(Состояние.Ссылка, Правила, Описание.Показатели));
			ОбъектыОтвета.Добавить(Элемент);
		КонецЦикла;

	КонецЦикла;

	Тело = Новый Соответствие;
	Тело.Вставить("Версия", Версия);
	Тело.Вставить("Объекты", ОбъектыОтвета);

	Возврат Новый Структура("КодСостояния, Тело", 200, Тело);

КонецФункции // ОтветЭталон

// Формирует ответ на запрос "ПоискПоGUID": ищет документы в типе источника правила каждого GUID
// и сообщает их состояние и признак "подлежит выгрузке".
//
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляОтправки.
//   ДанныеЗапроса - Соответствие - Объекты (Массив из Соответствие: УникальныйИдентификатор, ИмяПравила).
//
// Возвращаемое значение:
//   Структура - КодСостояния (Число), Тело (Соответствие: Версия, Объекты).
//
Функция ОтветПоискПоGUID(УчетнаяЗапись, ДанныеЗапроса)

	Версия = ВерсияКонтрактаИсточника();
	ТекстОшибкиСтруктуры = НСтр("ru = 'В запросе ""ПоискПоGUID"" нужен массив ""Объекты"" с полями ""УникальныйИдентификатор"" и ""ИмяПравила"".'");

	ОбъектыЗапроса = ДанныеЗапроса.Получить("Объекты");
	Если ТипЗнч(ОбъектыЗапроса) <> Тип("Массив") Тогда
		Возврат ОтветОшибки(400, ТекстОшибкиСтруктуры, Версия);
	КонецЕсли;

	ОбъектыПоПравилу = Новый Соответствие;
	ПорядокПравил = Новый Массив;
	Для Каждого ОбъектЗапроса Из ОбъектыЗапроса Цикл
		Если ТипЗнч(ОбъектЗапроса) <> Тип("Соответствие")
			Или ТипЗнч(ОбъектЗапроса.Получить("УникальныйИдентификатор")) <> Тип("Строка")
			Или ТипЗнч(ОбъектЗапроса.Получить("ИмяПравила")) <> Тип("Строка") Тогда
			Возврат ОтветОшибки(400, ТекстОшибкиСтруктуры, Версия);
		КонецЕсли;
		ИмяПравила = ОбъектЗапроса.Получить("ИмяПравила");
		Если ОбъектыПоПравилу.Получить(ИмяПравила) = Неопределено Тогда
			ОбъектыПоПравилу.Вставить(ИмяПравила, Новый Массив);
			ПорядокПравил.Добавить(ИмяПравила);
		КонецЕсли;
		ОбъектыПоПравилу.Получить(ИмяПравила).Добавить(ОбъектЗапроса);
	КонецЦикла;

	ОбменОбъект = УчетнаяЗапись.ПолучитьОбъект();
	ЭлементыПоОбъекту = Новый Соответствие;

	Для Каждого ИмяПравила Из ПорядокПравил Цикл

		Описание = ПравилоИсточника(ОбменОбъект, ИмяПравила);
		Если ЗначениеЗаполнено(Описание.ТекстОшибки) Тогда
			Возврат ОтветОшибки(422, Описание.ТекстОшибки, Версия);
		КонецЕсли;

		МетаданныеДокумента = Описание.МетаданныеДокумента;
		МенеджерДокумента = Документы[МетаданныеДокумента.Имя];
		ОбъектыПравила = ОбъектыПоПравилу.Получить(ИмяПравила);

		Ссылки = Новый Массив;
		СсылкиПоОбъекту = Новый Соответствие;
		Для Каждого ОбъектЗапроса Из ОбъектыПравила Цикл
			Попытка
				Ссылка = МенеджерДокумента.ПолучитьСсылку(
					Новый УникальныйИдентификатор(ОбъектЗапроса.Получить("УникальныйИдентификатор")));
			Исключение
				Продолжить;
			КонецПопытки;
			Ссылки.Добавить(Ссылка);
			СсылкиПоОбъекту.Вставить(ОбъектЗапроса, Ссылка);
		КонецЦикла;

		Состояния = СостоянияДокументов(МетаданныеДокумента, Ссылки);

		Для Каждого ОбъектЗапроса Из ОбъектыПравила Цикл

			Элемент = Новый Соответствие;
			Элемент.Вставить("УникальныйИдентификатор", ОбъектЗапроса.Получить("УникальныйИдентификатор"));
			ЭлементыПоОбъекту.Вставить(ОбъектЗапроса, Элемент);

			Ссылка = СсылкиПоОбъекту.Получить(ОбъектЗапроса);
			Если Ссылка = Неопределено Тогда
				Элемент.Вставить("Найден", Ложь);
				Элемент.Вставить("Ошибка", НСтр("ru = 'Некорректный уникальный идентификатор.'"));
				Продолжить;
			КонецЕсли;

			Состояние = Состояния.Найти(Ссылка, "Ссылка");
			Если Состояние = Неопределено Тогда
				Элемент.Вставить("Найден", Ложь);
				Продолжить;
			КонецЕсли;

			Элемент.Вставить("Найден", Истина);
			Элемент.Вставить("ИмяПравила", ИмяПравила);
			Элемент.Вставить("Тип", МетаданныеДокумента.ПолноеИмя());
			Элемент.Вставить("Номер", Строка(Состояние.Номер));
			Элемент.Вставить("Дата", XMLСтрока(Состояние.Дата));
			Элемент.Вставить("Проведен", Состояние.Проведен);
			Элемент.Вставить("ПометкаУдаления", Состояние.ПометкаУдаления);
			Элемент.Вставить("ПодлежитВыгрузке", ПодлежитВыгрузке(Ссылка, Состояние.Дата, Описание.СхемаКД,
				ОбменОбъект.ДатаНачалаВыгрузкиДокументов));

		КонецЦикла;

	КонецЦикла;

	ОбъектыОтвета = Новый Массив;
	Для Каждого ОбъектЗапроса Из ОбъектыЗапроса Цикл
		ОбъектыОтвета.Добавить(ЭлементыПоОбъекту.Получить(ОбъектЗапроса));
	КонецЦикла;

	Тело = Новый Соответствие;
	Тело.Вставить("Версия", Версия);
	Тело.Вставить("Объекты", ОбъектыОтвета);

	Возврат Новый Структура("КодСостояния, Тело", 200, Тело);

КонецФункции // ОтветПоискПоGUID

// Находит правило конвертации источника по коду и проверяет, что по нему можно сверять документы.
//
// Параметры:
//   ОбменОбъект - СправочникОбъект.СМП_УчетныеЗаписиОбменов - запись ДляОтправки.
//   ИмяПравила - Строка - код ПКО.
//
// Возвращаемое значение:
//   Структура - ПКО (СправочникСсылка.ПравилаКонвертацииОбъектов), МетаданныеДокумента (ОбъектМетаданных),
//               СхемаКД (СхемаКомпоновкиДанных, Неопределено - без отбора), ТекстОшибки (Строка, Неопределено - ошибки нет).
//
Функция ПравилоИсточника(ОбменОбъект, ИмяПравила)

	Результат = Новый Структура("ПКО, МетаданныеДокумента, СхемаКД, ТекстОшибки");

	ПКО = НайтиПКОПоКоду(ОбменОбъект.Ссылка, ИмяПравила);
	Если ПКО = Неопределено Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'В источнике нет правила конвертации объектов с кодом ""%1"".'"), ИмяПравила);
		Возврат Результат;
	КонецЕсли;

	МетаданныеДокумента = МетаданныеДокументаПоТипу(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПКО, "ТипИсточника"));
	Если МетаданныеДокумента = Неопределено Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Правило ""%1"" в источнике конвертирует не документ.'"), ИмяПравила);
		Возврат Результат;
	КонецЕсли;

	СтрокаНастройки = ОбменОбъект.ОбъектыКВыгрузке.Найти(МетаданныеДокумента.ПолноеИмя(), "ПолноеИмяОбъекта");
	Если СтрокаНастройки = Неопределено Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Документ ""%1"" не выгружается учетной записью источника.'"),
			МетаданныеДокумента.Представление());
		Возврат Результат;
	КонецЕсли;

	Результат.ПКО = ПКО;
	Результат.МетаданныеДокумента = МетаданныеДокумента;
	Результат.СхемаКД = СтрокаНастройки.СКДДляОтборов.Получить();

	Возврат Результат;

КонецФункции // ПравилоИсточника

// Проверяет, подлежит ли документ выгрузке учетной записью: дата не раньше даты начала выгрузки
// документов и документ проходит условия отбора (ПРД) строки ОбъектыКВыгрузке.
//
// Параметры:
//   Ссылка - ДокументСсылка - документ.
//   Дата - Дата - дата документа.
//   СхемаКД - СхемаКомпоновкиДанных, Неопределено - условия отбора; Неопределено - без отбора.
//   ДатаНачалаВыгрузкиДокументов - Дата - дата начала выгрузки документов учетной записи.
//
// Возвращаемое значение:
//   Булево
//
Функция ПодлежитВыгрузке(Ссылка, Дата, СхемаКД, ДатаНачалаВыгрузкиДокументов)

	Если Дата < ДатаНачалаВыгрузкиДокументов Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СхемаКД = Неопределено Или СМП_ОнлайнОбменСобытия.ПроверитьОбъектПоУсловиямОтбора(СхемаКД, Ссылка);

КонецФункции // ПодлежитВыгрузке

// Читает состояние документов одним запросом.
//
// Параметры:
//   МетаданныеДокумента - ОбъектМетаданных - документ.
//   Ссылки - Массив из ДокументСсылка - ссылки этого типа.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Ссылка, Номер, Дата, Проведен, ПометкаУдаления; индекс по Ссылка.
//
Функция СостоянияДокументов(МетаданныеДокумента, Ссылки)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.Проведен КАК Проведен,
	|	Т.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	%1 КАК Т
	|ГДЕ
	|	Т.Ссылка В (&Ссылки)", МетаданныеДокумента.ПолноеИмя());
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Состояния = Запрос.Выполнить().Выгрузить();
	Состояния.Индексы.Добавить("Ссылка");

	Возврат Состояния;

КонецФункции // СостоянияДокументов

#КонецОбласти

#Область ДанныеСверкиИсточника

// Статусы документа в результате сверки (порядок важен: проверяются сверху вниз).
//
// Возвращаемое значение:
//   Структура - ключ: идентификатор статуса; значение: Строка - представление.
//
Функция СтатусыСверки() Экспорт
	
	Статусы = Новый Структура;
	Статусы.Вставить("ОшибкаЗапроса", НСтр("ru = 'Ошибка запроса'"));
	Статусы.Вставить("НетВПриемнике", НСтр("ru = 'Нет в приемнике'"));
	Статусы.Вставить("НетВИсточнике", НСтр("ru = 'Нет в источнике'"));
	Статусы.Вставить("НеПодлежитВыгрузке", НСтр("ru = 'Не подлежит выгрузке'"));
	Статусы.Вставить("СостояниеОтличается", НСтр("ru = 'Состояние отличается'"));
	Статусы.Вставить("РасхождениеПоказателей", НСтр("ru = 'Расхождение показателей'"));
	Статусы.Вставить("ПоказательНеПроверен", НСтр("ru = 'Показатель не проверен'"));
	Статусы.Вставить("Совпадает", НСтр("ru = 'Совпадает'"));
	
	Возврат Статусы;
	
КонецФункции // СтатусыСверки

// Возвращает типы документов, доступные для сверки по учетной записи.
// ДляОтправки - строки ОбъектыКВыгрузке; ДляПолучения - уникальные типы приемника ПКО записи (только документы).
//
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - учетная запись обмена.
//
// Возвращаемое значение:
//   СписокЗначений - значение: Строка - полное имя документа; представление - синоним.
//
Функция ТипыДокументовДляСверки(УчетнаяЗапись) Экспорт

	Результат = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат Результат;
	КонецЕсли;

	НастройкаОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетнаяЗапись, "НастройкаОбмена");

	Если НастройкаОбмена = Перечисления.СМП_НастройкиОбменов.ДляОтправки Тогда

		Для Каждого СтрокаТЧ Из УчетнаяЗапись.ОбъектыКВыгрузке Цикл
			Представление = ?(ПустаяСтрока(СтрокаТЧ.Синоним), СтрокаТЧ.ПолноеИмяОбъекта, СтрокаТЧ.Синоним);
			Результат.Добавить(СтрокаТЧ.ПолноеИмяОбъекта, Представление);
		КонецЦикла;

	ИначеЕсли НастройкаОбмена = Перечисления.СМП_НастройкиОбменов.ДляПолучения Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПКО.ТипПриемника КАК ТипПриемника
		|ИЗ
		|	Справочник.ПравилаКонвертацииОбъектов КАК ПКО
		|ГДЕ
		|	ПКО.Владелец = &УчетнаяЗапись
		|	И НЕ ПКО.ЭтоГруппа
		|	И НЕ ПКО.ПометкаУдаления
		|	И ПКО.ТипПриемника ПОДОБНО ""ДокументСсылка.%""";
		Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МетаданныеДокумента = МетаданныеДокументаПоТипу(Выборка.ТипПриемника);
			Если МетаданныеДокумента <> Неопределено Тогда
				Результат.Добавить(МетаданныеДокумента.ПолноеИмя(), МетаданныеДокумента.Представление());
			КонецЕсли;
		КонецЦикла;
		Результат.СортироватьПоПредставлению();

	КонецЕсли;

	Возврат Результат;

КонецФункции // ТипыДокументовДляСверки

// Собирает данные сверки документов источника с приемником. Режим определяет учетная запись:
// ДляОтправки - сверка в источнике, ДляПолучения - сверка в приемнике (см. ДанныеСверкиПриемника()).
//
// Параметры:
//   Параметры - Структура:
//     * УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляОтправки или ДляПолучения.
//     * ТипДокумента - Строка - полное имя документа, например "Документ.РасходнаяНакладная".
//     * НачалоПериода - Дата.
//     * КонецПериода - Дата.
//     * РазмерПорции - Число - сколько GUID в одном запросе к другой базе (по умолчанию 50).
//     * Таймаут - Число - секунд на один запрос (по умолчанию 60).
//
// Возвращаемое значение:
//   ТаблицаЗначений - строка на пару "документ x показатель"; документ без показателей - одна строка.
//
Функция ПолучитьДанныеСверки(Параметры) Экспорт
	
	НастройкаОбмена = ПроверитьПараметрыСверки(Параметры);
	Если НастройкаОбмена = Перечисления.СМП_НастройкиОбменов.ДляПолучения Тогда
		Возврат ДанныеСверкиПриемника(Параметры);
	КонецЕсли;

	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(Параметры.ТипДокумента);
	ПКО = ПКОДляТипаДокумента(Параметры.УчетнаяЗапись, МетаданныеДокумента);
	ИмяПравила = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПКО, "Код");
	Правила = ПравилаСверки(ПКО);
	КодыПоказателей = Правила.ВыгрузитьКолонку("Код");
	
	Состояния = ЭталонныйНабор(Параметры, МетаданныеДокумента);
	Результат = НоваяТаблицаСверки(МетаданныеДокумента);
	Если Состояния.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	НастройкиТранспорта = СМП_ОнлайнОбмен.ПолучитьНастройкиТранспортаОбменаДанными(Параметры.УчетнаяЗапись);
	ОтветыПриемника = Новый Соответствие;
	ОшибкиЗапросов = Новый Соответствие;
	
	Порция = Новый Массив;
	Для Каждого Состояние Из Состояния Цикл
		Порция.Добавить(Строка(Состояние.Ссылка.УникальныйИдентификатор()));
		Если Порция.Количество() >= Параметры.РазмерПорции Тогда
			ЗапроситьПорцию(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Порция, Параметры.Таймаут,
				ОтветыПриемника, ОшибкиЗапросов);
			Порция = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Порция.Количество() > 0 Тогда
		ЗапроситьПорцию(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Порция, Параметры.Таймаут,
			ОтветыПриемника, ОшибкиЗапросов);
	КонецЕсли;
	
	Для Каждого Состояние Из Состояния Цикл

		Идентификатор = Строка(Состояние.Ссылка.УникальныйИдентификатор());

		Шапка = НоваяШапкаСверки();
		Шапка.Документ = Состояние.Ссылка;
		Шапка.Правило = ИмяПравила;
		Шапка.НомерИсточник = Строка(Состояние.Номер);
		Шапка.ДатаИсточник = Состояние.Дата;
		Шапка.ПроведенИсточник = Состояние.Проведен;
		Шапка.ПометкаУдаленияИсточник = Состояние.ПометкаУдаления;

		ОшибкаЗапроса = ОшибкиЗапросов.Получить(Идентификатор);
		ОбъектОтвета = ОтветыПриемника.Получить(Идентификатор);
		ПоказателиПриемника = Неопределено;
		ОшибкаОбъекта = Неопределено;
		Если ОшибкаЗапроса = Неопределено И ОбъектОтвета <> Неопределено Тогда
			Шапка.Найден = (ОбъектОтвета.Получить("Найден") = Истина);
			Если Шапка.Найден Тогда
				ПоказателиПриемника = ЗаполнитьСторонуИзОтвета(Шапка, ОбъектОтвета, "Приемник");
			КонецЕсли;
			ОшибкаОбъекта = ОбъектОтвета.Получить("Ошибка");
		КонецЕсли;

		Если Правила.Количество() = 0 Тогда
			ПоказателиИсточника = Новый Соответствие;
		Иначе
			ПоказателиИсточника = ПоказателиДляОтвета(Состояние.Ссылка, Правила, КодыПоказателей);
		КонецЕсли;

		ДобавитьСтрокиСверки(Результат, Шапка, Правила, ПоказателиИсточника, ПоказателиПриемника,
			ОшибкаЗапроса, ОшибкаОбъекта);

	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПолучитьДанныеСверки

// Проверяет параметры сверки и дополняет их значениями по умолчанию.
//
// Параметры:
//   Параметры - Структура - см. ПолучитьДанныеСверки().
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СМП_НастройкиОбменов - ДляОтправки или ДляПолучения.
//
Функция ПроверитьПараметрыСверки(Параметры)

	Если Не ЗначениеЗаполнено(Параметры.УчетнаяЗапись) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрана учетная запись обмена.'");
	КонецЕсли;

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.УчетнаяЗапись,
		"НастройкаОбмена, ХттпСервисАдресПодключения, ИдентификаторОбмена");
	ЭтоПолучение = (Реквизиты.НастройкаОбмена = Перечисления.СМП_НастройкиОбменов.ДляПолучения);
	Если Реквизиты.НастройкаОбмена <> Перечисления.СМП_НастройкиОбменов.ДляОтправки И Не ЭтоПолучение Тогда
		ВызватьИсключение НСтр("ru = 'Выберите учетную запись обмена.'");
	КонецЕсли;
	Если ПустаяСтрока(Реквизиты.ХттпСервисАдресПодключения) Тогда
		Если ЭтоПолучение Тогда
			ВызватьИсключение НСтр("ru = 'В учетной записи обмена не указан адрес подключения к базе-источнику.'");
		КонецЕсли;
		ВызватьИсключение НСтр("ru = 'В учетной записи обмена не указан адрес подключения к базе-приемнику.'");
	КонецЕсли;
	Если ПустаяСтрока(Реквизиты.ИдентификаторОбмена) Тогда
		ВызватьИсключение НСтр("ru = 'В учетной записи обмена не указан идентификатор обмена.'");
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.ТипДокумента)
		Или Метаданные.НайтиПоПолномуИмени(Параметры.ТипДокумента) = Неопределено
		Или Не Метаданные.Документы.Содержит(Метаданные.НайтиПоПолномуИмени(Параметры.ТипДокумента)) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбран тип документа для сверки.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.НачалоПериода) Или Не ЗначениеЗаполнено(Параметры.КонецПериода)
		Или Параметры.КонецПериода < Параметры.НачалоПериода Тогда
		ВызватьИсключение НСтр("ru = 'Период сверки указан неверно.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.РазмерПорции) Или Параметры.РазмерПорции < 1 Тогда
		Параметры.РазмерПорции = 50;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Параметры.Таймаут) Или Параметры.Таймаут < 1 Тогда
		Параметры.Таймаут = 60;
	КонецЕсли;

	Возврат Реквизиты.НастройкаОбмена;

КонецФункции // ПроверитьПараметрыСверки

Функция ПКОДляТипаДокумента(УчетнаяЗапись, МетаданныеДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПКО.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов КАК ПКО
	|ГДЕ
	|	ПКО.Владелец = &УчетнаяЗапись
	|	И ПКО.ТипИсточника = &ТипИсточника
	|	И НЕ ПКО.ЭтоГруппа
	|	И НЕ ПКО.ПометкаУдаления";
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ТипИсточника", "ДокументСсылка." + МетаданныеДокумента.Имя);
	Найденные = Запрос.Выполнить().Выгрузить();
	
	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В учетной записи нет правила конвертации объектов для документа ""%1"".'"),
			МетаданныеДокумента.Представление());
	ИначеЕсли Найденные.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Для документа ""%1"" найдено несколько правил конвертации объектов - такая сверка пока не поддерживается.'"),
			МетаданныеДокумента.Представление());
	КонецЕсли;
	
	Возврат Найденные[0].Ссылка;
	
КонецФункции // ПКОДляТипаДокумента

Функция ЭталонныйНабор(Параметры, МетаданныеДокумента)
	
	ОбменОбъект = Параметры.УчетнаяЗапись.ПолучитьОбъект();
	СтрокаНастройки = ОбменОбъект.ОбъектыКВыгрузке.Найти(МетаданныеДокумента.ПолноеИмя(), "ПолноеИмяОбъекта");
	Если СтрокаНастройки = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Документ ""%1"" не выгружается этой учетной записью обмена.'"),
			МетаданныеДокумента.Представление());
	КонецЕсли;
	СхемаКД = СтрокаНастройки.СКДДляОтборов.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.Проведен КАК Проведен,
	|	Т.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	%1 КАК Т
	|ГДЕ
	|	Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата,
	|	Т.Ссылка", МетаданныеДокумента.ПолноеИмя());
	Запрос.УстановитьПараметр("НачалоПериода",
		Макс(НачалоДня(Параметры.НачалоПериода), ОбменОбъект.ДатаНачалаВыгрузкиДокументов));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Параметры.КонецПериода));
	Состояния = Запрос.Выполнить().Выгрузить();
	
	Если СхемаКД <> Неопределено Тогда
		Всего = Состояния.Количество();
		Для Смещение = 1 По Всего Цикл
			Строка = Состояния[Всего - Смещение];
			Если Не СМП_ОнлайнОбменСобытия.ПроверитьОбъектПоУсловиямОтбора(СхемаКД, Строка.Ссылка) Тогда
				Состояния.Удалить(Строка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Состояния;
	
КонецФункции // ЭталонныйНабор

Процедура ЗапроситьПорцию(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Порция, Таймаут,
	ОтветыПриемника, ОшибкиЗапросов)
	
	Результат = ВыполнитьЗапросСверки(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Порция, Таймаут);
	
	Если Результат.Успешно Тогда
		Для Каждого ОбъектОтвета Из Результат.Объекты Цикл
			Если ТипЗнч(ОбъектОтвета) = Тип("Соответствие") Тогда
				ОтветыПриемника.Вставить(Строка(ОбъектОтвета.Получить("УникальныйИдентификатор")), ОбъектОтвета);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Идентификатор Из Порция Цикл
			Если ОтветыПриемника.Получить(Идентификатор) = Неопределено Тогда
				ОшибкиЗапросов.Вставить(Идентификатор, НСтр("ru = 'Приемник не вернул данные по документу.'"));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Идентификатор Из Порция Цикл
			ОшибкиЗапросов.Вставить(Идентификатор, Результат.ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ЗапроситьПорцию

Функция ВыполнитьЗапросСверки(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Идентификаторы, Таймаут)
	
	Результат = Новый Структура("Успешно, Объекты, ТекстОшибки", Ложь, Новый Массив, "");
	
	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("Версия", ВерсияКонтракта());
	ТелоЗапроса.Вставить("ИмяПравила", ИмяПравила);
	ТелоЗапроса.Вставить("Показатели", КодыПоказателей);
	ТелоЗапроса.Вставить("Объекты", Идентификаторы);

	Попытка
		Ответ = ОтправитьЗапросValidate(НастройкиТранспорта, ТелоЗапроса, Таймаут);
	Исключение
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось выполнить запрос к приемнику: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	Попытка
		ДанныеОтвета = СМП_КоннекторHTTP.JsonВОбъект(СМП_КоннекторHTTP.КакТекст(Ответ));
	Исключение
		ДанныеОтвета = Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(ДанныеОтвета) <> Тип("Соответствие") Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Приемник вернул ответ не в формате сверки (код %1). Вероятно, в приемнике версия расширения без сверки - обновите расширение в приемнике.'"),
			Ответ.КодСостояния);
		Возврат Результат;
	КонецЕсли;
	
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Приемник отклонил запрос сверки (код %1): %2'"),
			Ответ.КодСостояния, ДанныеОтвета.Получить("Ошибка"));
		Возврат Результат;
	КонецЕсли;
	
	Если ДанныеОтвета.Получить("Версия") <> ВерсияКонтракта() Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Приемник ответил в версии контракта ""%1"", источник понимает ""%2"" - обновите расширение.'"),
			ДанныеОтвета.Получить("Версия"), ВерсияКонтракта());
		Возврат Результат;
	КонецЕсли;
	
	Объекты = ДанныеОтвета.Получить("Объекты");
	Если ТипЗнч(Объекты) <> Тип("Массив") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В ответе приемника нет списка объектов.'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успешно = Истина;
	Результат.Объекты = Объекты;
	Возврат Результат;
	
КонецФункции // ВыполнитьЗапросСверки

// Отправляет запрос /validate/{ИдентификаторОбмена} другой базе обмена: JSON в gzip, Basic-авторизация, POST.
// Исключение транспорта не перехватывается.
//
// Параметры:
//   НастройкиТранспорта - Структура - см. СМП_ОнлайнОбмен.ПолучитьНастройкиТранспортаОбменаДанными().
//   ТелоЗапроса - Соответствие - тело запроса сверки.
//   Таймаут - Число - секунд на запрос.
//
// Возвращаемое значение:
//   Структура - ответ СМП_КоннекторHTTP.Post().
//
Функция ОтправитьЗапросValidate(НастройкиТранспорта, ТелоЗапроса, Таймаут)

	Адрес = НастройкиТранспорта.ИнтернетАдрес;
	URI = Адрес + ?(СтрЗаканчиваетсяНа(Адрес, "/"), "", "/")
		+ "hs/smp_exchange/validate/" + НастройкиТранспорта.ИдентификаторОбмена;

	СтрокаАвторизации = НастройкиТранспорта.ИмяПользователя + ":" + НастройкиТранспорта.ПарольПользователя;
	Сессия = СМП_КоннекторHTTP.СоздатьСессию();
	Сессия.Заголовки.Вставить("Authorization",
		"Basic " + Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(СтрокаАвторизации, КодировкаТекста.UTF8, Ложь)));
	Сессия.Заголовки.Вставить("content-type", "application/json");

	Тело = СМП_КоннекторHTTP.ЗаписатьGZip(ПолучитьДвоичныеДанныеИзСтроки(СМП_КоннекторHTTP.ОбъектВJson(ТелоЗапроса)));

	Возврат СМП_КоннекторHTTP.Post(URI, Тело, Новый Структура("Таймаут", Таймаут), Сессия);

КонецФункции // ОтправитьЗапросValidate

// Создает таблицу результата сверки. Колонки "Источник / Приемник" абсолютны в обоих режимах.
//
// Параметры:
//   МетаданныеДокумента - ОбъектМетаданных - документ своей базы.
//
// Возвращаемое значение:
//   ТаблицаЗначений - строка на пару "документ x показатель".
//
Функция НоваяТаблицаСверки(МетаданныеДокумента)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка." + МетаданныеДокумента.Имя));
	Таблица.Колонки.Добавить("Правило", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("НомерИсточник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("ДатаИсточник", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Таблица.Колонки.Добавить("ПроведенИсточник", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПометкаУдаленияИсточник", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Найден", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("НомерПриемник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("ДатаПриемник", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Таблица.Колонки.Добавить("ПроведенПриемник", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПометкаУдаленияПриемник", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Таблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	Таблица.Колонки.Добавить("ЗначениеИсточник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Таблица.Колонки.Добавить("ЗначениеПриемник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Таблица.Колонки.Добавить("Расхождение", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Информативный", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));

	Возврат Таблица;

КонецФункции // НоваяТаблицаСверки

// Создает шапку документа для ДобавитьСтрокиСверки().
//
// Возвращаемое значение:
//   Структура - Документ, Правило, НомерИсточник, ДатаИсточник, ПроведенИсточник, ПометкаУдаленияИсточник, Найден,
//               НомерПриемник, ДатаПриемник, ПроведенПриемник, ПометкаУдаленияПриемник, Статус.
//
Функция НоваяШапкаСверки()

	Шапка = Новый Структура("Документ, Правило, НомерИсточник, ДатаИсточник, ПроведенИсточник, ПометкаУдаленияИсточник,
		|Найден, НомерПриемник, ДатаПриемник, ПроведенПриемник, ПометкаУдаленияПриемник, Статус");
	Шапка.Правило = "";
	Шапка.НомерИсточник = "";
	Шапка.ДатаИсточник = Дата(1, 1, 1);
	Шапка.ПроведенИсточник = Ложь;
	Шапка.ПометкаУдаленияИсточник = Ложь;
	Шапка.Найден = Ложь;
	Шапка.НомерПриемник = "";
	Шапка.ДатаПриемник = Дата(1, 1, 1);
	Шапка.ПроведенПриемник = Ложь;
	Шапка.ПометкаУдаленияПриемник = Ложь;
	Шапка.Статус = "";

	Возврат Шапка;

КонецФункции // НоваяШапкаСверки

// Заполняет сторону шапки (номер, дату, состояние) из объекта ответа другой базы.
//
// Параметры:
//   Шапка - Структура - см. НоваяШапкаСверки().
//   ОбъектОтвета - Соответствие - объект ответа /validate.
//   Сторона - Строка - "Источник" или "Приемник".
//
// Возвращаемое значение:
//   Соответствие - Показатели ответа; не Соответствие в ответе - пустое Соответствие.
//
Функция ЗаполнитьСторонуИзОтвета(Шапка, ОбъектОтвета, Сторона)

	Шапка["Номер" + Сторона] = Строка(ОбъектОтвета.Получить("Номер"));
	Попытка
		Шапка["Дата" + Сторона] = XMLЗначение(Тип("Дата"), ОбъектОтвета.Получить("Дата"));
	Исключение
		Шапка["Дата" + Сторона] = Дата(1, 1, 1);
	КонецПопытки;
	Шапка["Проведен" + Сторона] = (ОбъектОтвета.Получить("Проведен") = Истина);
	Шапка["ПометкаУдаления" + Сторона] = (ОбъектОтвета.Получить("ПометкаУдаления") = Истина);

	Показатели = ОбъектОтвета.Получить("Показатели");
	Если ТипЗнч(Показатели) <> Тип("Соответствие") Тогда
		Показатели = Новый Соответствие;
	КонецЕсли;

	Возврат Показатели;

КонецФункции // ЗаполнитьСторонуИзОтвета

// Добавляет в результат строки документа ("документ x показатель") и определяет его статус.
//
// Параметры:
//   Результат - ТаблицаЗначений - см. НоваяТаблицаСверки().
//   Шапка - Структура - см. НоваяШапкаСверки(); заполненный Статус (НетВИсточнике, НеПодлежитВыгрузке) сохраняется.
//   Правила - ТаблицаЗначений - см. ПравилаСверки(); пустая - одна строка без показателя.
//   ПоказателиИсточника - Соответствие, Неопределено - показатели в формате контракта; Неопределено - стороны нет.
//   ПоказателиПриемника - Соответствие, Неопределено - показатели в формате контракта; Неопределено - стороны нет.
//   ОшибкаЗапроса - Строка, Неопределено - ошибка запроса порции или дня.
//   ОшибкаОбъекта - Строка, Неопределено - ошибка по объекту из ответа.
//
Процедура ДобавитьСтрокиСверки(Результат, Шапка, Правила, ПоказателиИсточника, ПоказателиПриемника, ОшибкаЗапроса,
	ОшибкаОбъекта = Неопределено)

	Статусы = СтатусыСверки();

	СтрокиПоказателей = Новый Массив;
	ЕстьРасхождение = Ложь;
	ЕстьНепроверенный = Ложь;

	Для Каждого Правило Из Правила Цикл

		СтрокаПоказателя = Новый Структура("Показатель, Порядок, ЗначениеИсточник, ЗначениеПриемник,
			|Расхождение, Информативный, Ошибка",
			Правило.Наименование, Правило.Порядок, "", "", Ложь, Правило.Информативный, "");
		Ошибки = Новый Массив;

		Источник = ЗначениеПоказателяСтороны(ПоказателиИсточника, Правило.Код, НСтр("ru = 'Источник'"), Ошибки);
		Если Источник <> Неопределено Тогда
			СтрокаПоказателя.ЗначениеИсточник = ПредставлениеПоказателя(Источник.Значение);
		КонецЕсли;

		Приемник = ЗначениеПоказателяСтороны(ПоказателиПриемника, Правило.Код, НСтр("ru = 'Приемник'"), Ошибки);
		Если Приемник <> Неопределено Тогда
			СтрокаПоказателя.ЗначениеПриемник = ПредставлениеПоказателя(Приемник.Значение);
		КонецЕсли;

		Если Источник <> Неопределено И Приемник <> Неопределено И Не Правило.Информативный
			И Не ЗначенияСовпадают(Источник.Значение, Приемник.Значение, Правило.Допуск) Тогда
			СтрокаПоказателя.Расхождение = Истина;
			ЕстьРасхождение = Истина;
		КонецЕсли;

		Если Ошибки.Количество() > 0 Тогда
			СтрокаПоказателя.Ошибка = СтрСоединить(Ошибки, "; ");
			ЕстьНепроверенный = Истина;
		КонецЕсли;

		СтрокиПоказателей.Добавить(СтрокаПоказателя);

	КонецЦикла;

	Если ОшибкаЗапроса <> Неопределено Тогда
		Шапка.Статус = Статусы.ОшибкаЗапроса;
	ИначеЕсли Не Шапка.Найден Тогда
		Шапка.Статус = Статусы.НетВПриемнике;
	ИначеЕсли ЗначениеЗаполнено(Шапка.Статус) Тогда
		// НетВИсточнике или НеПодлежитВыгрузке - определены вызывающим.
	ИначеЕсли Шапка.ПроведенИсточник <> Шапка.ПроведенПриемник
		Или Шапка.ПометкаУдаленияИсточник <> Шапка.ПометкаУдаленияПриемник Тогда
		Шапка.Статус = Статусы.СостояниеОтличается;
	ИначеЕсли ЕстьРасхождение Тогда
		Шапка.Статус = Статусы.РасхождениеПоказателей;
	ИначеЕсли ЕстьНепроверенный Тогда
		Шапка.Статус = Статусы.ПоказательНеПроверен;
	Иначе
		Шапка.Статус = Статусы.Совпадает;
	КонецЕсли;

	Если СтрокиПоказателей.Количество() = 0 Тогда
		СтрокиПоказателей.Добавить(Новый Структура("Показатель, Порядок, ЗначениеИсточник, ЗначениеПриемник,
			|Расхождение, Информативный, Ошибка", "", 0, "", "", Ложь, Ложь, ""));
	КонецЕсли;

	ОшибкаДокумента = ?(ОшибкаЗапроса <> Неопределено, ОшибкаЗапроса, ОшибкаОбъекта);

	Для Каждого СтрокаПоказателя Из СтрокиПоказателей Цикл
		Если ОшибкаДокумента <> Неопределено Тогда
			СтрокаПоказателя.Ошибка = ОшибкаДокумента;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Шапка);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоказателя);
	КонецЦикла;

КонецПроцедуры // ДобавитьСтрокиСверки

// Разбирает показатель одной стороны в формате контракта (Значение | Ошибка | НеНастроен).
//
// Параметры:
//   Показатели - Соответствие, Неопределено - показатели стороны; Неопределено - стороны нет.
//   Код - Строка - код показателя.
//   ИмяСтороны - Строка - префикс текста ошибки.
//   Ошибки - Массив из Строка - сюда добавляется ошибка показателя.
//
// Возвращаемое значение:
//   Структура - со свойством Значение; Неопределено - стороны нет или значения нет (ошибка добавлена в Ошибки).
//
Функция ЗначениеПоказателяСтороны(Показатели, Код, ИмяСтороны, Ошибки)

	Если Показатели = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Показатель = Показатели.Получить(Код);
	Если ТипЗнч(Показатель) <> Тип("Соответствие") Или Показатель.Получить("НеНастроен") = Истина Тогда
		Ошибки.Добавить(ИмяСтороны + НСтр("ru = ': показатель не настроен'"));
		Возврат Неопределено;
	ИначеЕсли Показатель.Получить("Ошибка") <> Неопределено Тогда
		Ошибки.Добавить(ИмяСтороны + ": " + Показатель.Получить("Ошибка"));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Значение", Показатель.Получить("Значение"));

КонецФункции // ЗначениеПоказателяСтороны

Функция ПредставлениеПоказателя(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0");
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции // ПредставлениеПоказателя

#КонецОбласти

#Область ДанныеСверкиПриемника

// Собирает данные сверки в базе-приемнике: эталон по дням запрашивается у источника (контракт версии 2),
// свои документы сравниваются с ним по своим правилам сверки; "лишние" - документы, полученные этим обменом
// (регистр СМП_ПолученныеОбъекты), которых нет в эталоне дня, - проверяются запросом "ПоискПоGUID".
//
// Параметры:
//   Параметры - Структура - см. ПолучитьДанныеСверки(); УчетнаяЗапись - запись ДляПолучения.
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. НоваяТаблицаСверки().
//
Функция ДанныеСверкиПриемника(Параметры)

	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(Параметры.ТипДокумента);
	ПКОТипа = ПКОДляТипаПриемника(Параметры.УчетнаяЗапись, МетаданныеДокумента);

	ПравилаПоКоду = Новый Соответствие;
	ПравилаЗапроса = Новый Массив;
	Для Каждого СтрокаПКО Из ПКОТипа Цикл
		Правила = ПравилаСверки(СтрокаПКО.Ссылка);
		ПравилаПоКоду.Вставить(СтрокаПКО.Код, Правила);
		ПравилоЗапроса = Новый Соответствие;
		ПравилоЗапроса.Вставить("ИмяПравила", СтрокаПКО.Код);
		ПравилоЗапроса.Вставить("Показатели", Правила.ВыгрузитьКолонку("Код"));
		ПравилаЗапроса.Добавить(ПравилоЗапроса);
	КонецЦикла;

	НастройкиТранспорта = СМП_ОнлайнОбмен.ПолучитьНастройкиТранспортаОбменаДанными(Параметры.УчетнаяЗапись);
	Результат = НоваяТаблицаСверки(МетаданныеДокумента);

	День = НачалоДня(Параметры.НачалоПериода);
	Пока День <= Параметры.КонецПериода Цикл

		ТелоЗапроса = Новый Соответствие;
		ТелоЗапроса.Вставить("Версия", ВерсияКонтрактаИсточника());
		ТелоЗапроса.Вставить("Запрос", "Эталон");
		ТелоЗапроса.Вставить("Правила", ПравилаЗапроса);
		ТелоЗапроса.Вставить("НачалоПериода", XMLСтрока(День));
		ТелоЗапроса.Вставить("КонецПериода", XMLСтрока(КонецДня(День)));

		Ответ = ВыполнитьЗапросКИсточнику(НастройкиТранспорта, ТелоЗапроса, Параметры.Таймаут, "Эталон");

		Если Ответ.Успешно Тогда
			СсылкиЭталона = ДобавитьСтрокиЭталона(Результат, Ответ.Объекты, МетаданныеДокумента, ПравилаПоКоду);
			ДобавитьСтрокиЛишних(Результат, Параметры.УчетнаяЗапись, МетаданныеДокумента, День, СсылкиЭталона,
				НастройкиТранспорта, Параметры);
		Иначе
			Шапка = НоваяШапкаСверки();
			Шапка.ДатаИсточник = День;
			ДобавитьСтрокиСверки(Результат, Шапка, Новый ТаблицаЗначений, Неопределено, Неопределено,
				Ответ.ТекстОшибки);
		КонецЕсли;

		День = День + 86400;

	КонецЦикла;

	Возврат Результат;

КонецФункции // ДанныеСверкиПриемника

// Возвращает правила конвертации учетной записи, которые конвертируют в документ приемника.
//
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляПолучения.
//   МетаданныеДокумента - ОбъектМетаданных - документ приемника.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Ссылка, Код; не пустая (иначе исключение).
//
Функция ПКОДляТипаПриемника(УчетнаяЗапись, МетаданныеДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПКО.Ссылка КАК Ссылка,
	|	ПКО.Код КАК Код
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов КАК ПКО
	|ГДЕ
	|	ПКО.Владелец = &УчетнаяЗапись
	|	И ПКО.ТипПриемника = &ТипПриемника
	|	И НЕ ПКО.ЭтоГруппа
	|	И НЕ ПКО.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ТипПриемника", "ДокументСсылка." + МетаданныеДокумента.Имя);
	Найденные = Запрос.Выполнить().Выгрузить();

	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В учетной записи нет правил конвертации объектов в документ ""%1"".'"),
			МетаданныеДокумента.Представление());
	КонецЕсли;

	Возврат Найденные;

КонецФункции // ПКОДляТипаПриемника

// Выполняет запрос сверки к источнику (контракт версии 2) и разбирает ответ.
// Ошибки, одинаковые для каждого дня (запись не найдена, старое расширение в источнике, ошибка правила
// в "Эталоне"), прерывают формирование отчета исключением.
//
// Параметры:
//   НастройкиТранспорта - Структура - см. СМП_ОнлайнОбмен.ПолучитьНастройкиТранспортаОбменаДанными().
//   ТелоЗапроса - Соответствие - тело запроса.
//   Таймаут - Число - секунд на запрос.
//   Запрос - Строка - вид запроса: "Эталон" или "ПоискПоGUID".
//
// Возвращаемое значение:
//   Структура - Успешно (Булево), Объекты (Массив), ТекстОшибки (Строка).
//
Функция ВыполнитьЗапросКИсточнику(НастройкиТранспорта, ТелоЗапроса, Таймаут, Запрос)

	Результат = Новый Структура("Успешно, Объекты, ТекстОшибки", Ложь, Новый Массив, "");

	Попытка
		Ответ = ОтправитьЗапросValidate(НастройкиТранспорта, ТелоЗапроса, Таймаут);
	Исключение
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось выполнить запрос к источнику: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;

	Попытка
		ДанныеОтвета = СМП_КоннекторHTTP.JsonВОбъект(СМП_КоннекторHTTP.КакТекст(Ответ));
	Исключение
		ДанныеОтвета = Неопределено;
	КонецПопытки;

	Если ТипЗнч(ДанныеОтвета) <> Тип("Соответствие") Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Источник вернул ответ не в формате сверки (код %1). Вероятно, в источнике версия расширения без сверки - обновите расширение в источнике.'"),
			Ответ.КодСостояния);
		Возврат Результат;
	КонецЕсли;

	КодСостояния = Ответ.КодСостояния;
	Если КодСостояния <> 200 Тогда

		ВерсияОтвета = ДанныеОтвета.Получить("Версия");
		Если (КодСостояния = 404 Или КодСостояния = 400) И ВерсияОтвета <> ВерсияКонтрактаИсточника() Тогда
			ВызватьИсключение НСтр("ru = 'В источнике версия расширения без сверки по запросу приемника - обновите расширение в источнике.'");
		КонецЕсли;

		ТекстОшибки = СтрШаблон(НСтр("ru = 'Источник отклонил запрос сверки (код %1): %2'"),
			КодСостояния, ДанныеОтвета.Получить("Ошибка"));
		Если КодСостояния = 404 Или КодСостояния = 400 Или (КодСостояния = 422 И Запрос = "Эталон") Тогда
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;

		Результат.ТекстОшибки = ТекстОшибки;
		Возврат Результат;

	КонецЕсли;

	Если ДанныеОтвета.Получить("Версия") <> ВерсияКонтрактаИсточника() Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Источник ответил в версии контракта ""%1"", приемник понимает ""%2"" - обновите расширение.'"),
			ДанныеОтвета.Получить("Версия"), ВерсияКонтрактаИсточника());
		Возврат Результат;
	КонецЕсли;

	Объекты = ДанныеОтвета.Получить("Объекты");
	Если ТипЗнч(Объекты) <> Тип("Массив") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В ответе источника нет списка объектов.'");
		Возврат Результат;
	КонецЕсли;

	Результат.Успешно = Истина;
	Результат.Объекты = Объекты;
	Возврат Результат;

КонецФункции // ВыполнитьЗапросКИсточнику

// Добавляет строки документов эталона дня: сторона источника - из ответа, сторона приемника - свой документ
// с тем же GUID, показатели - по своим правилам ПКО с кодом ИмяПравила.
//
// Параметры:
//   Результат - ТаблицаЗначений - см. НоваяТаблицаСверки().
//   Объекты - Массив из Соответствие - объекты ответа "Эталон".
//   МетаданныеДокумента - ОбъектМетаданных - документ приемника.
//   ПравилаПоКоду - Соответствие - ключ: код ПКО; значение: ТаблицаЗначений - см. ПравилаСверки().
//
// Возвращаемое значение:
//   Массив из ДокументСсылка - документы эталона, найденные в приемнике.
//
Функция ДобавитьСтрокиЭталона(Результат, Объекты, МетаданныеДокумента, ПравилаПоКоду)

	МенеджерДокумента = Документы[МетаданныеДокумента.Имя];

	Ссылки = Новый Массив;
	СсылкиОбъектов = Новый Соответствие;
	Для Каждого Объект Из Объекты Цикл
		Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Ссылка = МенеджерДокумента.ПолучитьСсылку(Новый УникальныйИдентификатор(Объект.Получить("УникальныйИдентификатор")));
		Исключение
			Продолжить;
		КонецПопытки;
		Ссылки.Добавить(Ссылка);
		СсылкиОбъектов.Вставить(Объект, Ссылка);
	КонецЦикла;

	Состояния = СостоянияДокументов(МетаданныеДокумента, Ссылки);
	СсылкиЭталона = Новый Массив;

	Для Каждого Объект Из Объекты Цикл

		Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		ИмяПравила = Объект.Получить("ИмяПравила");
		Шапка = НоваяШапкаСверки();
		Шапка.Правило = ?(ТипЗнч(ИмяПравила) = Тип("Строка"), ИмяПравила, "");
		ПоказателиИсточника = ЗаполнитьСторонуИзОтвета(Шапка, Объект, "Источник");

		ОшибкаЗапроса = Неопределено;
		ОшибкаОбъекта = Неопределено;
		ПоказателиПриемника = Неопределено;

		Правила = ПравилаПоКоду.Получить(ИмяПравила);
		Если Правила = Неопределено Тогда
			ОшибкаЗапроса = СтрШаблон(
				НСтр("ru = 'Источник вернул документ по правилу ""%1"", которого нет в запросе.'"), ИмяПравила);
			Правила = Новый ТаблицаЗначений;
		КонецЕсли;

		Ссылка = СсылкиОбъектов.Получить(Объект);
		Если Ссылка = Неопределено Тогда
			ОшибкаОбъекта = НСтр("ru = 'Некорректный уникальный идентификатор.'");
		Иначе
			Состояние = Состояния.Найти(Ссылка, "Ссылка");
			Если Состояние <> Неопределено Тогда
				СсылкиЭталона.Добавить(Ссылка);
				Шапка.Документ = Ссылка;
				Шапка.Найден = Истина;
				Шапка.НомерПриемник = Строка(Состояние.Номер);
				Шапка.ДатаПриемник = Состояние.Дата;
				Шапка.ПроведенПриемник = Состояние.Проведен;
				Шапка.ПометкаУдаленияПриемник = Состояние.ПометкаУдаления;
				Если Правила.Количество() = 0 Тогда
					ПоказателиПриемника = Новый Соответствие;
				Иначе
					ПоказателиПриемника = ПоказателиДляОтвета(Ссылка, Правила, Правила.ВыгрузитьКолонку("Код"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		ДобавитьСтрокиСверки(Результат, Шапка, Правила, ПоказателиИсточника, ПоказателиПриемника,
			ОшибкаЗапроса, ОшибкаОбъекта);

	КонецЦикла;

	Возврат СсылкиЭталона;

КонецФункции // ДобавитьСтрокиЭталона

// Добавляет строки "лишних" документов дня: полученных этим обменом (регистр СМП_ПолученныеОбъекты),
// но отсутствующих в эталоне. Источник проверяет их запросом "ПоискПоGUID" порциями в пределах одного правила.
// Показатели не вычисляются (решение П1).
//
// Параметры:
//   Результат - ТаблицаЗначений - см. НоваяТаблицаСверки().
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляПолучения.
//   МетаданныеДокумента - ОбъектМетаданных - документ приемника.
//   День - Дата - начало дня.
//   СсылкиЭталона - Массив из ДокументСсылка - документы эталона дня, найденные в приемнике.
//   НастройкиТранспорта - Структура - см. СМП_ОнлайнОбмен.ПолучитьНастройкиТранспортаОбменаДанными().
//   Параметры - Структура - см. ПолучитьДанныеСверки().
//
Процедура ДобавитьСтрокиЛишних(Результат, УчетнаяЗапись, МетаданныеДокумента, День, СсылкиЭталона,
	НастройкиТранспорта, Параметры)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.Проведен КАК Проведен,
	|	Т.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	%1 КАК Т
	|ГДЕ
	|	Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ Т.Ссылка В (&СсылкиЭталона)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата,
	|	Т.Ссылка", МетаданныеДокумента.ПолноеИмя());
	Запрос.УстановитьПараметр("НачалоПериода", День);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(День));
	Запрос.УстановитьПараметр("СсылкиЭталона", СсылкиЭталона);
	ДокументыДня = Запрос.Выполнить().Выгрузить();
	Если ДокументыДня.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Полученные = РегистрыСведений.СМП_ПолученныеОбъекты.ОтобратьПолученные(УчетнаяЗапись, ДокументыДня);
	Если Полученные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КандидатыПоПравилу = Новый Соответствие;
	ПорядокПравил = Новый Массив;
	Для Каждого СтрокаДокумента Из ДокументыДня Цикл
		ИмяПравила = Полученные.Получить(СтрокаДокумента.Ссылка);
		Если ИмяПравила = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если КандидатыПоПравилу.Получить(ИмяПравила) = Неопределено Тогда
			КандидатыПоПравилу.Вставить(ИмяПравила, Новый Массив);
			ПорядокПравил.Добавить(ИмяПравила);
		КонецЕсли;
		КандидатыПоПравилу.Получить(ИмяПравила).Добавить(СтрокаДокумента);
	КонецЦикла;

	Для Каждого ИмяПравила Из ПорядокПравил Цикл
		Порция = Новый Массив;
		Для Каждого Кандидат Из КандидатыПоПравилу.Получить(ИмяПравила) Цикл
			Порция.Добавить(Кандидат);
			Если Порция.Количество() >= Параметры.РазмерПорции Тогда
				ДобавитьСтрокиПорцииЛишних(Результат, Порция, ИмяПравила, НастройкиТранспорта, Параметры.Таймаут);
				Порция = Новый Массив;
			КонецЕсли;
		КонецЦикла;
		Если Порция.Количество() > 0 Тогда
			ДобавитьСтрокиПорцииЛишних(Результат, Порция, ИмяПравила, НастройкиТранспорта, Параметры.Таймаут);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры // ДобавитьСтрокиЛишних

// Проверяет порцию "лишних" документов одного правила запросом "ПоискПоGUID" и добавляет их строки.
//
// Параметры:
//   Результат - ТаблицаЗначений - см. НоваяТаблицаСверки().
//   Порция - Массив из СтрокаТаблицыЗначений - документы приемника (Ссылка, Номер, Дата, Проведен, ПометкаУдаления).
//   ИмяПравила - Строка - код ПКО из регистра СМП_ПолученныеОбъекты.
//   НастройкиТранспорта - Структура - см. СМП_ОнлайнОбмен.ПолучитьНастройкиТранспортаОбменаДанными().
//   Таймаут - Число - секунд на запрос.
//
Процедура ДобавитьСтрокиПорцииЛишних(Результат, Порция, ИмяПравила, НастройкиТранспорта, Таймаут)

	Статусы = СтатусыСверки();

	ОбъектыЗапроса = Новый Массив;
	Для Каждого Кандидат Из Порция Цикл
		ОбъектЗапроса = Новый Соответствие;
		ОбъектЗапроса.Вставить("УникальныйИдентификатор", Строка(Кандидат.Ссылка.УникальныйИдентификатор()));
		ОбъектЗапроса.Вставить("ИмяПравила", ИмяПравила);
		ОбъектыЗапроса.Добавить(ОбъектЗапроса);
	КонецЦикла;

	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("Версия", ВерсияКонтрактаИсточника());
	ТелоЗапроса.Вставить("Запрос", "ПоискПоGUID");
	ТелоЗапроса.Вставить("Объекты", ОбъектыЗапроса);

	Ответ = ВыполнитьЗапросКИсточнику(НастройкиТранспорта, ТелоЗапроса, Таймаут, "ПоискПоGUID");

	ОтветыПоИдентификатору = Новый Соответствие;
	Если Ответ.Успешно Тогда
		Для Каждого ОбъектОтвета Из Ответ.Объекты Цикл
			Если ТипЗнч(ОбъектОтвета) = Тип("Соответствие") Тогда
				ОтветыПоИдентификатору.Вставить(Строка(ОбъектОтвета.Получить("УникальныйИдентификатор")), ОбъектОтвета);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Кандидат Из Порция Цикл

		Шапка = НоваяШапкаСверки();
		Шапка.Документ = Кандидат.Ссылка;
		Шапка.Правило = ИмяПравила;
		Шапка.Найден = Истина;
		Шапка.НомерПриемник = Строка(Кандидат.Номер);
		Шапка.ДатаПриемник = Кандидат.Дата;
		Шапка.ПроведенПриемник = Кандидат.Проведен;
		Шапка.ПометкаУдаленияПриемник = Кандидат.ПометкаУдаления;

		ОшибкаЗапроса = Неопределено;
		Если Не Ответ.Успешно Тогда
			ОшибкаЗапроса = Ответ.ТекстОшибки;
		Иначе
			ОбъектОтвета = ОтветыПоИдентификатору.Получить(Строка(Кандидат.Ссылка.УникальныйИдентификатор()));
			Если ОбъектОтвета = Неопределено Тогда
				ОшибкаЗапроса = НСтр("ru = 'Источник не вернул данные по документу.'");
			ИначеЕсли ОбъектОтвета.Получить("Найден") <> Истина Тогда
				Шапка.Статус = Статусы.НетВИсточнике;
			ИначеЕсли ОбъектОтвета.Получить("ПодлежитВыгрузке") <> Истина Тогда
				ЗаполнитьСторонуИзОтвета(Шапка, ОбъектОтвета, "Источник");
				Шапка.Статус = Статусы.НеПодлежитВыгрузке;
			Иначе
				Продолжить; // В источнике есть и подлежит выгрузке - не показывается.
			КонецЕсли;
		КонецЕсли;

		ДобавитьСтрокиСверки(Результат, Шапка, Новый ТаблицаЗначений, Неопределено, Неопределено, ОшибкаЗапроса);

	КонецЦикла;

КонецПроцедуры // ДобавитьСтрокиПорцииЛишних

#КонецОбласти
