#Область ПравилаСверки

// Возвращает описание объекта метаданных той базы, в которой выполняется код:
// для учетной записи ДляОтправки - источник ПКО, для ДляПолучения - приемник ПКО.
//
// Параметры:
//   ПКО - СправочникСсылка.ПравилаКонвертацииОбъектов - правило, которому подчинено правило сверки.
//
// Возвращаемое значение:
//   СправочникСсылка.Объекты - объект своей базы; пустая ссылка, если ПКО не указано.
//
Функция ОбъектСвоейБазы(ПКО) Экспорт
	
	Если Не ЗначениеЗаполнено(ПКО) Тогда
		Возврат Справочники.Объекты.ПустаяСсылка();
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПКО,
		Новый Структура("Источник, Приемник, НастройкаОбмена", "Источник", "Приемник", "Владелец.НастройкаОбмена"));
	
	Если Реквизиты.НастройкаОбмена = Перечисления.СМП_НастройкиОбменов.ДляПолучения Тогда
		Возврат Реквизиты.Приемник;
	КонецЕсли;
	
	Возврат Реквизиты.Источник;
	
КонецФункции // ОбъектСвоейБазы

// Проверяет, есть ли среди типов свойства (описание метаданных КД2) ссылочный тип.
//
// Параметры:
//   Свойство - СправочникСсылка.Свойства - реквизит объекта метаданных.
//
// Возвращаемое значение:
//   Булево - Истина, если хотя бы один тип свойства - ссылка ("СправочникСсылка.Х", "ПеречислениеСсылка.Х" и т.п.).
//
Функция СвойствоИмеетСсылочныйТип(Свойство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Признак
	|ИЗ
	|	Справочник.Свойства.Типы КАК Типы
	|ГДЕ
	|	Типы.Ссылка = &Свойство
	|	И Типы.Тип.Наименование ПОДОБНО ""%Ссылка.%""";
	Запрос.УстановитьПараметр("Свойство", Свойство);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции // СвойствоИмеетСсылочныйТип

#КонецОбласти

#Область ВычислениеПоказателей

// Возвращает действующие правила сверки ПКО.
//
// Параметры:
//   ПКО - СправочникСсылка.ПравилаКонвертацииОбъектов - владелец правил.
//   КодыПоказателей - Массив из Строка, Неопределено - отбор по кодам; Неопределено - все правила.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: Код, Наименование, Вид, ИмяРеквизита, Выражение, Допуск, Информативный, Порядок.
//
Функция ПравилаСверки(ПКО, КодыПоказателей = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Код КАК Код,
	|	Правила.Наименование КАК Наименование,
	|	Правила.Вид КАК Вид,
	|	Правила.Реквизит.Наименование КАК ИмяРеквизита,
	|	Правила.Выражение КАК Выражение,
	|	Правила.Допуск КАК Допуск,
	|	Правила.Информативный КАК Информативный,
	|	Правила.Порядок КАК Порядок
	|ИЗ
	|	Справочник.СМП_ПравилаСверки КАК Правила
	|ГДЕ
	|	Правила.Владелец = &ПКО
	|	И НЕ Правила.ПометкаУдаления
	|	И НЕ Правила.Отключить
	|	И (НЕ &ОтборПоКодам
	|			ИЛИ Правила.Код В (&КодыПоказателей))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Код";
	Запрос.УстановитьПараметр("ПКО", ПКО);
	Запрос.УстановитьПараметр("ОтборПоКодам", КодыПоказателей <> Неопределено);
	Запрос.УстановитьПараметр("КодыПоказателей", ?(КодыПоказателей = Неопределено, Новый Массив, КодыПоказателей));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПравилаСверки

// Вычисляет показатели объекта по правилам сверки. Ошибка одного показателя не прерывает остальные.
//
// Параметры:
//   Объект - ДокументОбъект - объект, для которого вычисляются показатели.
//   Правила - ТаблицаЗначений - см. ПравилаСверки().
//
// Возвращаемое значение:
//   Соответствие - ключ: код показателя; значение: Структура со свойством Значение
//                  (см. НормализоватьЗначение()) или Ошибка (Строка).
//
Функция ВычислитьПоказатели(Объект, Правила) Экспорт
	
	Результат = Новый Соответствие;
	
	Для Каждого Правило Из Правила Цикл
		
		Попытка
			
			Если Правило.Вид = Перечисления.СМП_ВидыПоказателейСверки.Реквизит Тогда
				Значение = Объект[Правило.ИмяРеквизита];
			Иначе
				Значение = ВычислитьВыражение(Объект, Правило.Выражение);
			КонецЕсли;
			
			Если Не Правило.Информативный И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
				ВызватьИсключение НСтр("ru = 'Показатель вернул ссылку: сверять ссылки можно только как информативный показатель.'");
			КонецЕсли;
			
			Результат.Вставить(Правило.Код, Новый Структура("Значение", НормализоватьЗначение(Значение)));
			
		Исключение
			
			Результат.Вставить(Правило.Код, Новый Структура("Ошибка", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ВычислитьПоказатели

// Вычисляет показатели документа по ссылке; если объект прочитать не удалось - ошибка на каждом показателе.
//
// Параметры:
//   Ссылка - ДокументСсылка - документ.
//   Правила - ТаблицаЗначений - см. ПравилаСверки().
//
// Возвращаемое значение:
//   Соответствие - см. ВычислитьПоказатели().
//
Функция ВычислитьПоказателиДокумента(Ссылка, Правила) Экспорт
	
	Если Правила.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Объект = Неопределено;
	ТекстОшибки = Неопределено;
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Если Объект = Неопределено Тогда
		Если ТекстОшибки = Неопределено Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось прочитать документ.'");
		КонецЕсли;
		Результат = Новый Соответствие;
		Для Каждого Правило Из Правила Цикл
			Результат.Вставить(Правило.Код, Новый Структура("Ошибка", ТекстОшибки));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
	Возврат ВычислитьПоказатели(Объект, Правила);
	
КонецФункции // ВычислитьПоказателиДокумента

// Сравнивает нормализованные значения показателя источника и приемника.
// Разные типы (в т.ч. пустое значение против 0) - расхождение; числа - с допуском; строки, даты, булево - точно.
//
// Параметры:
//   ЗначениеИсточник - Число, Строка, Булево, Неопределено - см. НормализоватьЗначение().
//   ЗначениеПриемник - Число, Строка, Булево, Неопределено - значение из ответа приемника.
//   Допуск - Число - допустимая разница для чисел.
//
// Возвращаемое значение:
//   Булево - Истина, если значения совпадают.
//
Функция ЗначенияСовпадают(ЗначениеИсточник, ЗначениеПриемник, Допуск) Экспорт
	
	Если ТипЗнч(ЗначениеИсточник) <> ТипЗнч(ЗначениеПриемник) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеИсточник) = Тип("Число") Тогда
		Разница = ЗначениеИсточник - ЗначениеПриемник;
		Возврат Макс(Разница, -Разница) <= Допуск;
	КонецЕсли;
	
	Возврат ЗначениеИсточник = ЗначениеПриемник;
	
КонецФункции // ЗначенияСовпадают

// Приводит значение показателя к виду, пригодному для JSON и сравнения между базами.
//
// Параметры:
//   Значение - Произвольный - вычисленное значение.
//
// Возвращаемое значение:
//   Число, Булево - как есть; Строка - без концевых пробелов; дата - строкой XMLСтрока;
//   Неопределено - для Неопределено и Null; прочее - представление строкой.
//
Функция НормализоватьЗначение(Значение) Экспорт
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции // НормализоватьЗначение

// Вычисляет выражение правила в безопасном режиме. В выражении доступна переменная Объект.
// Безопасный режим выключается автоматически при выходе из функции.
//
// Параметры:
//   Объект - ДокументОбъект - контекст выражения.
//   Выражение - Строка - выражение встроенного языка (одно выражение, без операторов).
//
// Возвращаемое значение:
//   Произвольный - результат выражения.
//
Функция ВычислитьВыражение(Объект, Выражение)
	
	УстановитьБезопасныйРежим(Истина);
	Возврат Вычислить(Выражение);
	
КонецФункции // ВычислитьВыражение

#КонецОбласти

#Область ОбработкаЗапросаСверки

// Версия контракта /validate, которую понимает эта версия расширения.
//
// Возвращаемое значение:
//   Число
//
Функция ВерсияКонтракта() Экспорт
	
	Возврат 1;
	
КонецФункции // ВерсияКонтракта

// Имя события журнала регистрации для ошибок сверки.
//
// Возвращаемое значение:
//   Строка
//
Функция ИмяСобытияЖурнала() Экспорт
	
	Возврат НСтр("ru = 'СМП_ОнлайнОбмен.Сверка'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции // ИмяСобытияЖурнала

// Формирует ответ сервиса с ошибкой уровня запроса.
//
// Параметры:
//   КодСостояния - Число - код HTTP.
//   ТекстОшибки - Строка - текст для источника.
//
// Возвращаемое значение:
//   Структура - КодСостояния (Число), Тело (Соответствие: Версия, Ошибка).
//
Функция ОтветОшибки(КодСостояния, ТекстОшибки) Экспорт
	
	Тело = Новый Соответствие;
	Тело.Вставить("Версия", ВерсияКонтракта());
	Тело.Вставить("Ошибка", ТекстОшибки);
	
	Возврат Новый Структура("КодСостояния, Тело", КодСостояния, Тело);
	
КонецФункции // ОтветОшибки

// Обрабатывает запрос сверки в базе-приемнике (контракт - спецификация, раздел 3б).
//
// Параметры:
//   УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляПолучения.
//   ТелоЗапроса - Строка - JSON запроса (уже распакованный из gzip).
//
// Возвращаемое значение:
//   Структура - КодСостояния (Число), Тело (Соответствие).
//
Функция ОбработатьЗапросСверки(УчетнаяЗапись, ТелоЗапроса) Экспорт
	
	Попытка
		ДанныеЗапроса = СМП_КоннекторHTTP.JsonВОбъект(ТелоЗапроса);
	Исключение
		Возврат ОтветОшибки(400, НСтр("ru = 'Тело запроса сверки не является корректным JSON.'"));
	КонецПопытки;
	
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Соответствие") Тогда
		Возврат ОтветОшибки(400, НСтр("ru = 'Тело запроса сверки должно быть объектом JSON.'"));
	КонецЕсли;
	
	Версия = ДанныеЗапроса.Получить("Версия");
	Если Версия <> ВерсияКонтракта() Тогда
		Ответ = ОтветОшибки(400, СтрШаблон(
			НСтр("ru = 'Версия контракта сверки ""%1"" не поддерживается приемником.'"), Версия));
		ПоддерживаемыеВерсии = Новый Массив;
		ПоддерживаемыеВерсии.Добавить(ВерсияКонтракта());
		Ответ.Тело.Вставить("ПоддерживаемыеВерсии", ПоддерживаемыеВерсии);
		Возврат Ответ;
	КонецЕсли;
	
	ИмяПравила = ДанныеЗапроса.Получить("ИмяПравила");
	КодыПоказателей = ДанныеЗапроса.Получить("Показатели");
	ИдентификаторыОбъектов = ДанныеЗапроса.Получить("Объекты");
	Если ТипЗнч(ИмяПравила) <> Тип("Строка")
		Или ТипЗнч(КодыПоказателей) <> Тип("Массив")
		Или ТипЗнч(ИдентификаторыОбъектов) <> Тип("Массив") Тогда
		Возврат ОтветОшибки(400,
			НСтр("ru = 'В запросе сверки нужны ""ИмяПравила"" (строка), ""Показатели"" и ""Объекты"" (массивы).'"));
	КонецЕсли;
	
	ПКО = НайтиПКОПоКоду(УчетнаяЗапись, ИмяПравила);
	Если ПКО = Неопределено Тогда
		Возврат ОтветОшибки(422, СтрШаблон(
			НСтр("ru = 'В приемнике нет правила конвертации объектов с кодом ""%1"".'"), ИмяПравила));
	КонецЕсли;
	
	МетаданныеДокумента = МетаданныеДокументаПоТипу(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПКО, "ТипПриемника"));
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат ОтветОшибки(422, СтрШаблон(
			НСтр("ru = 'Правило ""%1"" в приемнике конвертирует не документ.'"), ИмяПравила));
	КонецЕсли;
	
	Правила = ПравилаСверки(ПКО, КодыПоказателей);
	МенеджерДокумента = Документы[МетаданныеДокумента.Имя];
	
	Ссылки = Новый Массив;
	СсылкиПоИдентификатору = Новый Соответствие;
	Для Каждого Идентификатор Из ИдентификаторыОбъектов Цикл
		Попытка
			Ссылка = МенеджерДокумента.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		Исключение
			Продолжить;
		КонецПопытки;
		Ссылки.Добавить(Ссылка);
		СсылкиПоИдентификатору.Вставить(Идентификатор, Ссылка);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.Проведен КАК Проведен,
	|	Т.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	%1 КАК Т
	|ГДЕ
	|	Т.Ссылка В (&Ссылки)", МетаданныеДокумента.ПолноеИмя());
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Состояния = Запрос.Выполнить().Выгрузить();
	Состояния.Индексы.Добавить("Ссылка");
	
	ОбъектыОтвета = Новый Массив;
	Для Каждого Идентификатор Из ИдентификаторыОбъектов Цикл
		
		Элемент = Новый Соответствие;
		Элемент.Вставить("УникальныйИдентификатор", Идентификатор);
		
		Ссылка = СсылкиПоИдентификатору.Получить(Идентификатор);
		Если Ссылка = Неопределено Тогда
			Элемент.Вставить("Найден", Ложь);
			Элемент.Вставить("Ошибка", НСтр("ru = 'Некорректный уникальный идентификатор.'"));
			ОбъектыОтвета.Добавить(Элемент);
			Продолжить;
		КонецЕсли;
		
		Состояние = Состояния.Найти(Ссылка, "Ссылка");
		Если Состояние = Неопределено Тогда
			Элемент.Вставить("Найден", Ложь);
			ОбъектыОтвета.Добавить(Элемент);
			Продолжить;
		КонецЕсли;
		
		Элемент.Вставить("Найден", Истина);
		Элемент.Вставить("Тип", МетаданныеДокумента.ПолноеИмя());
		Элемент.Вставить("Номер", Строка(Состояние.Номер));
		Элемент.Вставить("Дата", XMLСтрока(Состояние.Дата));
		Элемент.Вставить("Проведен", Состояние.Проведен);
		Элемент.Вставить("ПометкаУдаления", Состояние.ПометкаУдаления);
		Элемент.Вставить("Показатели", ПоказателиДляОтвета(Ссылка, Правила, КодыПоказателей));
		ОбъектыОтвета.Добавить(Элемент);
		
	КонецЦикла;
	
	Тело = Новый Соответствие;
	Тело.Вставить("Версия", ВерсияКонтракта());
	Тело.Вставить("ИмяПравила", ИмяПравила);
	Тело.Вставить("Объекты", ОбъектыОтвета);
	
	Возврат Новый Структура("КодСостояния, Тело", 200, Тело);
	
КонецФункции // ОбработатьЗапросСверки

Функция НайтиПКОПоКоду(УчетнаяЗапись, Код)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПКО.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов КАК ПКО
	|ГДЕ
	|	ПКО.Владелец = &УчетнаяЗапись
	|	И ПКО.Код = &Код
	|	И НЕ ПКО.ЭтоГруппа
	|	И НЕ ПКО.ПометкаУдаления";
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("Код", Код);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции // НайтиПКОПоКоду

Функция МетаданныеДокументаПоТипу(ТипСтрокой)
	
	Префикс = "ДокументСсылка.";
	Если ТипЗнч(ТипСтрокой) <> Тип("Строка") Или Не СтрНачинаетсяС(ТипСтрокой, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Метаданные.Документы.Найти(Сред(ТипСтрокой, СтрДлина(Префикс) + 1));
	
КонецФункции // МетаданныеДокументаПоТипу

Функция ПоказателиДляОтвета(Ссылка, Правила, КодыПоказателей)
	
	Вычисленные = ВычислитьПоказателиДокумента(Ссылка, Правила);
	
	Результат = Новый Соответствие;
	Для Каждого Код Из КодыПоказателей Цикл
		
		КодСтрокой = Строка(Код);
		Показатель = Новый Соответствие;
		Вычисленный = Вычисленные.Получить(КодСтрокой);
		Если Вычисленный = Неопределено Тогда
			Показатель.Вставить("НеНастроен", Истина);
		ИначеЕсли Вычисленный.Свойство("Ошибка") Тогда
			Показатель.Вставить("Ошибка", Вычисленный.Ошибка);
		Иначе
			Показатель.Вставить("Значение", Вычисленный.Значение);
		КонецЕсли;
		Результат.Вставить(КодСтрокой, Показатель);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПоказателиДляОтвета

#КонецОбласти

#Область ДанныеСверкиИсточника

// Статусы документа в результате сверки (порядок важен: проверяются сверху вниз).
//
// Возвращаемое значение:
//   Структура - ключ: идентификатор статуса; значение: Строка - представление.
//
Функция СтатусыСверки() Экспорт
	
	Статусы = Новый Структура;
	Статусы.Вставить("ОшибкаЗапроса", НСтр("ru = 'Ошибка запроса'"));
	Статусы.Вставить("НеНайден", НСтр("ru = 'Не найден'"));
	Статусы.Вставить("СостояниеОтличается", НСтр("ru = 'Состояние отличается'"));
	Статусы.Вставить("РасхождениеПоказателей", НСтр("ru = 'Расхождение показателей'"));
	Статусы.Вставить("ПоказательНеПроверен", НСтр("ru = 'Показатель не проверен'"));
	Статусы.Вставить("Совпадает", НСтр("ru = 'Совпадает'"));
	
	Возврат Статусы;
	
КонецФункции // СтатусыСверки

// Собирает данные сверки документов источника с приемником.
//
// Параметры:
//   Параметры - Структура:
//     * УчетнаяЗапись - СправочникСсылка.СМП_УчетныеЗаписиОбменов - запись ДляОтправки.
//     * ТипДокумента - Строка - полное имя документа, например "Документ.РасходнаяНакладная".
//     * НачалоПериода - Дата.
//     * КонецПериода - Дата.
//     * РазмерПорции - Число - сколько GUID в одном запросе к приемнику (по умолчанию 50).
//     * Таймаут - Число - секунд на один запрос (по умолчанию 60).
//
// Возвращаемое значение:
//   ТаблицаЗначений - строка на пару "документ x показатель"; документ без показателей - одна строка.
//
Функция ПолучитьДанныеСверки(Параметры) Экспорт
	
	ПроверитьПараметрыСверки(Параметры);
	
	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(Параметры.ТипДокумента);
	ПКО = ПКОДляТипаДокумента(Параметры.УчетнаяЗапись, МетаданныеДокумента);
	ИмяПравила = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПКО, "Код");
	Правила = ПравилаСверки(ПКО);
	КодыПоказателей = Правила.ВыгрузитьКолонку("Код");
	
	Состояния = ЭталонныйНабор(Параметры, МетаданныеДокумента);
	Результат = НоваяТаблицаСверки(МетаданныеДокумента);
	Если Состояния.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	НастройкиТранспорта = СМП_ОнлайнОбмен.ПолучитьНастройкиТранспортаОбменаДанными(Параметры.УчетнаяЗапись);
	ОтветыПриемника = Новый Соответствие;
	ОшибкиЗапросов = Новый Соответствие;
	
	Порция = Новый Массив;
	Для Каждого Состояние Из Состояния Цикл
		Порция.Добавить(Строка(Состояние.Ссылка.УникальныйИдентификатор()));
		Если Порция.Количество() >= Параметры.РазмерПорции Тогда
			ЗапроситьПорцию(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Порция, Параметры.Таймаут,
				ОтветыПриемника, ОшибкиЗапросов);
			Порция = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Порция.Количество() > 0 Тогда
		ЗапроситьПорцию(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Порция, Параметры.Таймаут,
			ОтветыПриемника, ОшибкиЗапросов);
	КонецЕсли;
	
	Для Каждого Состояние Из Состояния Цикл
		Идентификатор = Строка(Состояние.Ссылка.УникальныйИдентификатор());
		ДобавитьСтрокиДокумента(Результат, Состояние, Правила,
			ВычислитьПоказателиДокумента(Состояние.Ссылка, Правила),
			ОтветыПриемника.Получить(Идентификатор), ОшибкиЗапросов.Получить(Идентификатор));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПолучитьДанныеСверки

Процедура ПроверитьПараметрыСверки(Параметры)
	
	Если Не ЗначениеЗаполнено(Параметры.УчетнаяЗапись) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрана учетная запись обмена.'");
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.УчетнаяЗапись,
		"НастройкаОбмена, ХттпСервисАдресПодключения, ИдентификаторОбмена");
	Если Реквизиты.НастройкаОбмена <> Перечисления.СМП_НастройкиОбменов.ДляОтправки Тогда
		ВызватьИсключение НСтр("ru = 'Сверку запускают в базе-источнике: выберите учетную запись ""Для отправки"".'");
	КонецЕсли;
	Если ПустаяСтрока(Реквизиты.ХттпСервисАдресПодключения) Тогда
		ВызватьИсключение НСтр("ru = 'В учетной записи обмена не указан адрес подключения к базе-приемнику.'");
	КонецЕсли;
	Если ПустаяСтрока(Реквизиты.ИдентификаторОбмена) Тогда
		ВызватьИсключение НСтр("ru = 'В учетной записи обмена не указан идентификатор обмена.'");
	КонецЕсли;
	
	Если ПустаяСтрока(Параметры.ТипДокумента)
		Или Метаданные.НайтиПоПолномуИмени(Параметры.ТипДокумента) = Неопределено
		Или Не Метаданные.Документы.Содержит(Метаданные.НайтиПоПолномуИмени(Параметры.ТипДокумента)) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбран тип документа для сверки.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.НачалоПериода) Или Не ЗначениеЗаполнено(Параметры.КонецПериода)
		Или Параметры.КонецПериода < Параметры.НачалоПериода Тогда
		ВызватьИсключение НСтр("ru = 'Период сверки указан неверно.'");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.РазмерПорции) Или Параметры.РазмерПорции < 1 Тогда
		Параметры.РазмерПорции = 50;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Параметры.Таймаут) Или Параметры.Таймаут < 1 Тогда
		Параметры.Таймаут = 60;
	КонецЕсли;
	
КонецПроцедуры // ПроверитьПараметрыСверки

Функция ПКОДляТипаДокумента(УчетнаяЗапись, МетаданныеДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПКО.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов КАК ПКО
	|ГДЕ
	|	ПКО.Владелец = &УчетнаяЗапись
	|	И ПКО.ТипИсточника = &ТипИсточника
	|	И НЕ ПКО.ЭтоГруппа
	|	И НЕ ПКО.ПометкаУдаления";
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ТипИсточника", "ДокументСсылка." + МетаданныеДокумента.Имя);
	Найденные = Запрос.Выполнить().Выгрузить();
	
	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В учетной записи нет правила конвертации объектов для документа ""%1"".'"),
			МетаданныеДокумента.Представление());
	ИначеЕсли Найденные.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Для документа ""%1"" найдено несколько правил конвертации объектов - такая сверка пока не поддерживается.'"),
			МетаданныеДокумента.Представление());
	КонецЕсли;
	
	Возврат Найденные[0].Ссылка;
	
КонецФункции // ПКОДляТипаДокумента

Функция ЭталонныйНабор(Параметры, МетаданныеДокумента)
	
	ОбменОбъект = Параметры.УчетнаяЗапись.ПолучитьОбъект();
	СтрокаНастройки = ОбменОбъект.ОбъектыКВыгрузке.Найти(МетаданныеДокумента.ПолноеИмя(), "ПолноеИмяОбъекта");
	Если СтрокаНастройки = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Документ ""%1"" не выгружается этой учетной записью обмена.'"),
			МетаданныеДокумента.Представление());
	КонецЕсли;
	СхемаКД = СтрокаНастройки.СКДДляОтборов.Получить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.Проведен КАК Проведен,
	|	Т.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	%1 КАК Т
	|ГДЕ
	|	Т.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата,
	|	Т.Ссылка", МетаданныеДокумента.ПолноеИмя());
	Запрос.УстановитьПараметр("НачалоПериода",
		Макс(НачалоДня(Параметры.НачалоПериода), ОбменОбъект.ДатаНачалаВыгрузкиДокументов));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Параметры.КонецПериода));
	Состояния = Запрос.Выполнить().Выгрузить();
	
	Если СхемаКД <> Неопределено Тогда
		Всего = Состояния.Количество();
		Для Смещение = 1 По Всего Цикл
			Строка = Состояния[Всего - Смещение];
			Если Не СМП_ОнлайнОбменСобытия.ПроверитьОбъектПоУсловиямОтбора(СхемаКД, Строка.Ссылка) Тогда
				Состояния.Удалить(Строка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Состояния;
	
КонецФункции // ЭталонныйНабор

Процедура ЗапроситьПорцию(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Порция, Таймаут,
	ОтветыПриемника, ОшибкиЗапросов)
	
	Результат = ВыполнитьЗапросСверки(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Порция, Таймаут);
	
	Если Результат.Успешно Тогда
		Для Каждого ОбъектОтвета Из Результат.Объекты Цикл
			Если ТипЗнч(ОбъектОтвета) = Тип("Соответствие") Тогда
				ОтветыПриемника.Вставить(Строка(ОбъектОтвета.Получить("УникальныйИдентификатор")), ОбъектОтвета);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Идентификатор Из Порция Цикл
			Если ОтветыПриемника.Получить(Идентификатор) = Неопределено Тогда
				ОшибкиЗапросов.Вставить(Идентификатор, НСтр("ru = 'Приемник не вернул данные по документу.'"));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Идентификатор Из Порция Цикл
			ОшибкиЗапросов.Вставить(Идентификатор, Результат.ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ЗапроситьПорцию

Функция ВыполнитьЗапросСверки(НастройкиТранспорта, ИмяПравила, КодыПоказателей, Идентификаторы, Таймаут)
	
	Результат = Новый Структура("Успешно, Объекты, ТекстОшибки", Ложь, Новый Массив, "");
	
	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("Версия", ВерсияКонтракта());
	ТелоЗапроса.Вставить("ИмяПравила", ИмяПравила);
	ТелоЗапроса.Вставить("Показатели", КодыПоказателей);
	ТелоЗапроса.Вставить("Объекты", Идентификаторы);
	
	Адрес = НастройкиТранспорта.ИнтернетАдрес;
	URI = Адрес + ?(СтрЗаканчиваетсяНа(Адрес, "/"), "", "/")
		+ "hs/smp_exchange/validate/" + НастройкиТранспорта.ИдентификаторОбмена;
	
	СтрокаАвторизации = НастройкиТранспорта.ИмяПользователя + ":" + НастройкиТранспорта.ПарольПользователя;
	Сессия = СМП_КоннекторHTTP.СоздатьСессию();
	Сессия.Заголовки.Вставить("Authorization",
		"Basic " + Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(СтрокаАвторизации, КодировкаТекста.UTF8, Ложь)));
	Сессия.Заголовки.Вставить("content-type", "application/json");
	
	Тело = СМП_КоннекторHTTP.ЗаписатьGZip(ПолучитьДвоичныеДанныеИзСтроки(СМП_КоннекторHTTP.ОбъектВJson(ТелоЗапроса)));
	
	Попытка
		Ответ = СМП_КоннекторHTTP.Post(URI, Тело, Новый Структура("Таймаут", Таймаут), Сессия);
	Исключение
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось выполнить запрос к приемнику: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	Попытка
		ДанныеОтвета = СМП_КоннекторHTTP.JsonВОбъект(СМП_КоннекторHTTP.КакТекст(Ответ));
	Исключение
		ДанныеОтвета = Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(ДанныеОтвета) <> Тип("Соответствие") Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Приемник вернул ответ не в формате сверки (код %1). Вероятно, в приемнике версия расширения без сверки - обновите расширение в приемнике.'"),
			Ответ.КодСостояния);
		Возврат Результат;
	КонецЕсли;
	
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.ТекстОшибки = СтрШаблон(НСтр("ru = 'Приемник отклонил запрос сверки (код %1): %2'"),
			Ответ.КодСостояния, ДанныеОтвета.Получить("Ошибка"));
		Возврат Результат;
	КонецЕсли;
	
	Если ДанныеОтвета.Получить("Версия") <> ВерсияКонтракта() Тогда
		Результат.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Приемник ответил в версии контракта ""%1"", источник понимает ""%2"" - обновите расширение.'"),
			ДанныеОтвета.Получить("Версия"), ВерсияКонтракта());
		Возврат Результат;
	КонецЕсли;
	
	Объекты = ДанныеОтвета.Получить("Объекты");
	Если ТипЗнч(Объекты) <> Тип("Массив") Тогда
		Результат.ТекстОшибки = НСтр("ru = 'В ответе приемника нет списка объектов.'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успешно = Истина;
	Результат.Объекты = Объекты;
	Возврат Результат;
	
КонецФункции // ВыполнитьЗапросСверки

Функция НоваяТаблицаСверки(МетаданныеДокумента)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка." + МетаданныеДокумента.Имя));
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Таблица.Колонки.Добавить("ПроведенИсточник", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПометкаУдаленияИсточник", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Найден", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("НомерПриемник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("ДатаПриемник", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Таблица.Колонки.Добавить("ПроведенПриемник", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПометкаУдаленияПриемник", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Таблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	Таблица.Колонки.Добавить("ЗначениеИсточник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Таблица.Колонки.Добавить("ЗначениеПриемник", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	Таблица.Колонки.Добавить("Расхождение", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Информативный", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	
	Возврат Таблица;
	
КонецФункции // НоваяТаблицаСверки

Процедура ДобавитьСтрокиДокумента(Результат, Состояние, Правила, ПоказателиИсточника, ОбъектОтвета, ОшибкаЗапроса)
	
	Статусы = СтатусыСверки();
	
	Шапка = Новый Структура("Документ, Номер, Дата, ПроведенИсточник, ПометкаУдаленияИсточник, Найден,
		|НомерПриемник, ДатаПриемник, ПроведенПриемник, ПометкаУдаленияПриемник, Статус");
	Шапка.Документ = Состояние.Ссылка;
	Шапка.Номер = Строка(Состояние.Номер);
	Шапка.Дата = Состояние.Дата;
	Шапка.ПроведенИсточник = Состояние.Проведен;
	Шапка.ПометкаУдаленияИсточник = Состояние.ПометкаУдаления;
	Шапка.Найден = Ложь;
	
	ОшибкаДокумента = ОшибкаЗапроса;
	ПоказателиПриемника = Неопределено;
	Если ОшибкаЗапроса = Неопределено И ОбъектОтвета <> Неопределено Тогда
		Если ОбъектОтвета.Получить("Найден") = Истина Тогда
			Шапка.Найден = Истина;
			Шапка.НомерПриемник = Строка(ОбъектОтвета.Получить("Номер"));
			Попытка
				Шапка.ДатаПриемник = XMLЗначение(Тип("Дата"), ОбъектОтвета.Получить("Дата"));
			Исключение
				Шапка.ДатаПриемник = Дата(1, 1, 1);
			КонецПопытки;
			Шапка.ПроведенПриемник = (ОбъектОтвета.Получить("Проведен") = Истина);
			Шапка.ПометкаУдаленияПриемник = (ОбъектОтвета.Получить("ПометкаУдаления") = Истина);
			ПоказателиПриемника = ОбъектОтвета.Получить("Показатели");
			Если ТипЗнч(ПоказателиПриемника) <> Тип("Соответствие") Тогда
				ПоказателиПриемника = Новый Соответствие;
			КонецЕсли;
		ИначеЕсли ОбъектОтвета.Получить("Ошибка") <> Неопределено Тогда
			ОшибкаДокумента = ОбъектОтвета.Получить("Ошибка");
		КонецЕсли;
	КонецЕсли;
	
	СтрокиПоказателей = Новый Массив;
	ЕстьРасхождение = Ложь;
	ЕстьНепроверенный = Ложь;
	
	Для Каждого Правило Из Правила Цикл
		
		СтрокаПоказателя = Новый Структура("Показатель, Порядок, ЗначениеИсточник, ЗначениеПриемник,
			|Расхождение, Информативный, Ошибка",
			Правило.Наименование, Правило.Порядок, "", "", Ложь, Правило.Информативный, "");
		Ошибки = Новый Массив;
		
		Источник = ПоказателиИсточника.Получить(Правило.Код);
		Если Источник = Неопределено Или Источник.Свойство("Ошибка") Тогда
			Ошибки.Добавить(НСтр("ru = 'Источник: '") + ?(Источник = Неопределено, "", Источник.Ошибка));
		Иначе
			СтрокаПоказателя.ЗначениеИсточник = ПредставлениеПоказателя(Источник.Значение);
		КонецЕсли;
		
		Если ПоказателиПриемника <> Неопределено Тогда
			Приемник = ПоказателиПриемника.Получить(Правило.Код);
			Если ТипЗнч(Приемник) <> Тип("Соответствие") Или Приемник.Получить("НеНастроен") = Истина Тогда
				Ошибки.Добавить(НСтр("ru = 'Приемник: показатель не настроен'"));
			ИначеЕсли Приемник.Получить("Ошибка") <> Неопределено Тогда
				Ошибки.Добавить(НСтр("ru = 'Приемник: '") + Приемник.Получить("Ошибка"));
			Иначе
				ЗначениеПриемника = Приемник.Получить("Значение");
				СтрокаПоказателя.ЗначениеПриемник = ПредставлениеПоказателя(ЗначениеПриемника);
				Если Источник <> Неопределено И Не Источник.Свойство("Ошибка") И Не Правило.Информативный
					И Не ЗначенияСовпадают(Источник.Значение, ЗначениеПриемника, Правило.Допуск) Тогда
					СтрокаПоказателя.Расхождение = Истина;
					ЕстьРасхождение = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Ошибки.Количество() > 0 Тогда
			СтрокаПоказателя.Ошибка = СтрСоединить(Ошибки, "; ");
			ЕстьНепроверенный = Истина;
		КонецЕсли;
		
		СтрокиПоказателей.Добавить(СтрокаПоказателя);
		
	КонецЦикла;
	
	Если ОшибкаЗапроса <> Неопределено Тогда
		Шапка.Статус = Статусы.ОшибкаЗапроса;
	ИначеЕсли Не Шапка.Найден Тогда
		Шапка.Статус = Статусы.НеНайден;
	ИначеЕсли Шапка.ПроведенИсточник <> Шапка.ПроведенПриемник
		Или Шапка.ПометкаУдаленияИсточник <> Шапка.ПометкаУдаленияПриемник Тогда
		Шапка.Статус = Статусы.СостояниеОтличается;
	ИначеЕсли ЕстьРасхождение Тогда
		Шапка.Статус = Статусы.РасхождениеПоказателей;
	ИначеЕсли ЕстьНепроверенный Тогда
		Шапка.Статус = Статусы.ПоказательНеПроверен;
	Иначе
		Шапка.Статус = Статусы.Совпадает;
	КонецЕсли;
	
	Если СтрокиПоказателей.Количество() = 0 Тогда
		СтрокиПоказателей.Добавить(Новый Структура("Показатель, Порядок, ЗначениеИсточник, ЗначениеПриемник,
			|Расхождение, Информативный, Ошибка", "", 0, "", "", Ложь, Ложь, ""));
	КонецЕсли;
	
	Для Каждого СтрокаПоказателя Из СтрокиПоказателей Цикл
		Если ОшибкаДокумента <> Неопределено Тогда
			СтрокаПоказателя.Ошибка = ОшибкаДокумента;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Шапка);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоказателя);
	КонецЦикла;
	
КонецПроцедуры // ДобавитьСтрокиДокумента

Функция ПредставлениеПоказателя(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Формат(Значение, "БЛ=Нет; БИ=Да");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0");
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции // ПредставлениеПоказателя

#КонецОбласти
