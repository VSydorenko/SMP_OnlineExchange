#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыСверки = Новый Структура;
	ПараметрыСверки.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ПараметрыСверки.Вставить("ТипДокумента", ТипДокумента);
	ПараметрыСверки.Вставить("НачалоПериода", НачалоПериода);
	ПараметрыСверки.Вставить("КонецПериода", КонецПериода);
	ПараметрыСверки.Вставить("РазмерПорции", РазмерПорции);
	ПараметрыСверки.Вставить("Таймаут", Таймаут);
	
	ДанныеСверки = СМП_ОнлайнОбменСверка.ПолучитьДанныеСверки(ПараметрыСверки);
	
	Если ТолькоРасхождения Тогда
		Совпадает = СМП_ОнлайнОбменСверка.СтатусыСверки().Совпадает;
		Всего = ДанныеСверки.Количество();
		Для Смещение = 1 По Всего Цикл
			СтрокаДанных = ДанныеСверки[Всего - Смещение];
			Если СтрокаДанных.Статус = Совпадает Тогда
				ДанныеСверки.Удалить(СтрокаДанных);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Настройки варианта, измененные пользователем в форме отчета (структура, отборы, оформление).
	// Компоновщик не инициализирован (отчет сформирован не из формы) - настройки по умолчанию.
	Схема = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	Если Настройки.Структура.Количество() = 0 Тогда
		Настройки = Схема.НастройкиПоУмолчанию;
	КонецЕсли;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, Новый Структура("ДанныеСверки", ДанныеСверки),
		ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
