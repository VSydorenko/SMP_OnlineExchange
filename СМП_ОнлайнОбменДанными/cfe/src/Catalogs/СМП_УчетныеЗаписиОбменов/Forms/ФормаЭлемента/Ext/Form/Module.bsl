&НаКлиенте
Асинх Процедура ПроверитьПодключение(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ТекстВопроса = "Нужно сохранить учетную запись перед проверкой подключения. Продолжить?";
		РежимВопроса = РежимДиалогаВопрос.ДаНет;
		Результат = Ждать ВопросАсинх(ТекстВопроса, РежимВопроса);
		Если Результат = КодВозвратаДиалога.Да Тогда
			ЭтотОбъект.Записать();
			ВыполнитьПроверкуПодключения();
		КонецЕсли;
	Иначе
		ВыполнитьПроверкуПодключения();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОписаниеКонфигурации(Команда)
	
	Если Объект.НастройкаОбмена = ПредопределенноеЗначение("Перечисление.СМП_НастройкиОбменов.ДляОтправки") Тогда
		СтруктураПараметров = Новый Структура("парКонфигурация", Объект.Приемник);
	ИначеЕсли Объект.НастройкаОбмена = ПредопределенноеЗначение("Перечисление.СМП_НастройкиОбменов.ДляПолучения") Тогда
		СтруктураПараметров = Новый Структура("парКонфигурация", Объект.Источник);
	КонецЕсли;
	
	ОткрытьФорму("Обработка.ЗагрузкаСтруктурыКонфигурации.Форма", СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОписаниеКонфигурации(Команда)
	Сообщить("Этот функционал в процессе разработки");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторКода(Команда)
	
	ТекстОбработчика = Элементы[ТекущийАктивныйОбработчик + "Редактор"].Документ.defaultView.editor.getValue();
	мПараметры = Новый Структура("ТекстОбработчика", ТекстОбработчика);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияРедактораКода", ЭтотОбъект);
	ОткрытьФорму("Обработка.СМП_РедакторКода.Форма", мПараметры, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Обработчик оповещения.
//
&НаКлиенте
Процедура ПослеЗакрытияРедактораКода(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Элементы[ТекущийАктивныйОбработчик + "Редактор"].Документ.defaultView.editor.setValue(РезультатЗакрытия);
	 
	Если РезультатЗакрытия <> Объект[ТекущийАктивныйОбработчик] Тогда
		Объект[ТекущийАктивныйОбработчик] = РезультатЗакрытия;
		Модифицированность = Истина;
		ОбновитьПризнакНаличияОбработчиковАлгоритмов();
	КонецЕсли;
	
КонецПроцедуры //ПослеЗакрытияРедактораКода

&НаКлиенте
Процедура ПКСВверх(Команда)
	
	Если Команда.ИспользуемаяТаблица.ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		ИзменитьПорядокПКС(Команда.ИспользуемаяТаблица.ТекущиеДанные.Ссылка, -1);
		Команда.ИспользуемаяТаблица.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПКСВниз(Команда)
	
	Если Команда.ИспользуемаяТаблица.ТекущиеДанные = Неопределено Тогда
		Возврат;
	Иначе
		ИзменитьПорядокПКС(Команда.ИспользуемаяТаблица.ТекущиеДанные.Ссылка, 1);
		Команда.ИспользуемаяТаблица.Обновить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет список реквизитов с алгоритмами:
//
// Параметры:
//   Нет.
//
&НаСервере
Процедура ЗаполнитьСписокАлгоритмов() 
	
	ЭтотОбъект.СписокАлгоритмов = Новый Структура;
	СписокАлгоритмов.Вставить("АлгоритмПослеЗагрузкиПравилОбменаРедактор", 				Объект.АлгоритмПослеЗагрузкиПравилОбмена);
	СписокАлгоритмов.Вставить("АлгоритмПередВыгрузкойДанныхРедактор", 					Объект.АлгоритмПередВыгрузкойДанных);
	СписокАлгоритмов.Вставить("АлгоритмПередПолучениемИзмененныхОбъектовРедактор", 		Объект.АлгоритмПередПолучениемИзмененныхОбъектов);
	СписокАлгоритмов.Вставить("АлгоритмПередВыгрузкойОбъектаРедактор", 					Объект.АлгоритмПередВыгрузкойОбъекта);
	СписокАлгоритмов.Вставить("АлгоритмПередОтправкойИнформацииОбУдаленииРедактор", 	Объект.АлгоритмПередОтправкойИнформацииОбУдалении);
	СписокАлгоритмов.Вставить("АлгоритмПередКонвертациейОбъектаРедактор", 				Объект.АлгоритмПередКонвертациейОбъекта);
	СписокАлгоритмов.Вставить("АлгоритмПослеВыгрузкиОбъектаРедактор", 					Объект.АлгоритмПослеВыгрузкиОбъекта);
	СписокАлгоритмов.Вставить("АлгоритмПослеВыгрузкиДанныхРедактор", 					Объект.АлгоритмПослеВыгрузкиДанных);
	СписокАлгоритмов.Вставить("АлгоритмПередЗагрузкойДанныхРедактор", 					Объект.АлгоритмПередЗагрузкойДанных);
	СписокАлгоритмов.Вставить("АлгоритмПослеЗагрузкиПараметровРедактор", 				Объект.АлгоритмПослеЗагрузкиПараметров);
	СписокАлгоритмов.Вставить("АлгоритмПослеПолученияИнформацииОбУзлахОбменаРедактор", 	Объект.АлгоритмПослеПолученияИнформацииОбУзлахОбмена);
	СписокАлгоритмов.Вставить("АлгоритмПередЗагрузкойОбъектаРедактор", 					Объект.АлгоритмПередЗагрузкойОбъекта);
	СписокАлгоритмов.Вставить("АлгоритмПриПолученииИнформацииОбУдаленииРедактор", 		Объект.АлгоритмПриПолученииИнформацииОбУдалении);
	СписокАлгоритмов.Вставить("АлгоритмПослеЗагрузкиОбъектаРедактор", 					Объект.АлгоритмПослеЗагрузкиОбъекта);
	СписокАлгоритмов.Вставить("АлгоритмПослеЗагрузкиДанныхРедактор", 					Объект.АлгоритмПослеЗагрузкиДанных);
	
КонецПроцедуры //ЗаполнитьСписокАлгоритмов

// Изменение порядка ПКС.
//
// Параметры:
//   СсылкаПКС - СправочникСсылка.ПравилаКонвертацииСвойств - текущее правило, для которого изменяется порядок
//   Направление - Число - признак увеличения или уменьшения
//
&НаСервереБезКонтекста
Процедура ИзменитьПорядокПКС(СсылкаПКС, Направление) 
	
	Справочники.ПравилаКонвертацииСвойств.ИзменитьПорядок(СсылкаПКС, Направление);
	
КонецПроцедуры //ИзменитьПорядокПКС

// Визуальное выделение вкладок с ПКС и ПКЗ.
//
// Параметры:
//   
//
&НаКлиенте
Процедура ОпределитьНаличиеПКСПКЗ() 
	
	сНаличиеПравил = НаличиеПКСПКЗ(ТекущееПКО);
	ЗаголовокПКС = ?(сНаличиеПравил.ПКС >0, СтрШаблон("Конвертация свойств (%1)", сНаличиеПравил.ПКС), "Конвертация свойств");
	ЗаголовокПКЗ = ?(сНаличиеПравил.ПКЗ > 0, СтрШаблон("Конвертация значений (%1)", сНаличиеПравил.ПКЗ), "Конвертация значений");
	
	Если сНаличиеПравил.ПКЗ > 0 И сНаличиеПравил.ПКС > 0
		ИЛИ (сНаличиеПравил.ПКС = 0 И сНаличиеПравил.ПКЗ = 0) Тогда
		Возврат;
	КонецЕсли;
	
	Если сНаличиеПравил.ПКЗ > 0 Тогда
		Элементы.СтраницыКонвертаций.ТекущаяСтраница = Элементы.СтраницаПКЗ;
	КонецЕсли;
	
	Если сНаличиеПравил.ПКС > 0 Тогда
		Элементы.СтраницыКонвертаций.ТекущаяСтраница = Элементы.СтраницаПКС;
	КонецЕсли;
	
КонецПроцедуры //ОпределитьНаличиеПКСПКЗ

// .
//
// Параметры:
//  ПКОСсылка - СправочникСсылка.ПравилаКонвертацииОбъектов - текущее ПКО
//
// Возвращаемое значение:
//   Структура - результат наличия ПКС и ПКЗ
//
&НаСервереБезКонтекста
Функция НаличиеПКСПКЗ(ПКОСсылка) 
	
	сРезультат = Новый Структура("ПКС, ПКЗ", 0, 0);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПравилаКонвертацииСвойств.Ссылка) КАК КоличествоПКС
	|ИЗ
	|	Справочник.ПравилаКонвертацииСвойств КАК ПравилаКонвертацииСвойств
	|ГДЕ
	|	ПравилаКонвертацииСвойств.Владелец = &Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПравилаКонвертацииЗначений.Ссылка) КАК КоличествоПКЗ
	|ИЗ
	|	Справочник.ПравилаКонвертацииЗначений КАК ПравилаКонвертацииЗначений
	|ГДЕ
	|	ПравилаКонвертацииЗначений.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", ПКОСсылка);
	мРезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка = мРезультатЗапроса[0].Выбрать();
	Выборка.Следующий();
	сРезультат.ПКС = Выборка.КоличествоПКС;
	Выборка = мРезультатЗапроса[1].Выбрать();
	Выборка.Следующий();
	сРезультат.ПКЗ = Выборка.КоличествоПКЗ;
	
	Возврат сРезультат;
	
КонецФункции // НаличиеПКСПКЗ

