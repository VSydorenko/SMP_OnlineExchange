
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерекомпилироватьПравилаРегистрации(Команда)

	Результат = ПерекомпилироватьПравилаРегистрацииНаСервере();

	Если Результат.Ошибки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Правила регистрации перекомпилированы: %1'"), Результат.Количество));
	Иначе
		Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Перекомпилировано учетных записей: %1, не удалось перекомпилировать: %2'"),
				Результат.Количество, Результат.Ошибки.Количество()));
	КонецЕсли;

	Элементы.Список.Обновить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Перекомпилирует правила регистрации всех активных учетных записей на отправку.
//
// Возвращаемое значение:
//   Структура - см. СМП_ОнлайнОбменПравилаРегистрации.ПерекомпилироватьПравила.
//
&НаСервереБезКонтекста
Функция ПерекомпилироватьПравилаРегистрацииНаСервере()

	Возврат СМП_ОнлайнОбменПравилаРегистрации.ПерекомпилироватьПравила();

КонецФункции

#КонецОбласти
